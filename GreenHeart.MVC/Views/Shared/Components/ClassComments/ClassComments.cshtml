@using GreenHeart.Application.Convertors
@using GreenHeart.Application.Extensions
@using GreenHeart.Application.Statics
@using GreenHeart.Domain.ViewModels.Gyms.ClassComments
@model List<ClientSideCommentViewModel>

    <h4>@Model.Count() نظر</h4>
@if (Model.CheckNullability())
{
    
        var userId = User.GetUserId();
    
    @foreach(var comment in Model)
    {
        <div class="comment-list comment-section" data-comment-id="@comment.Id" data-class-id="@comment.ClassId" id="comment_@comment.Id">
            <div class="single-comment justify-content-between d-flex">
                <div class="user justify-content-between d-flex">
                    <div class="thumb">
                        <img class="comment-img" src="@SavingPath.AvatarPath@((!string.IsNullOrEmpty(comment.Avatar))?$"{comment.Avatar}":"default.png")" alt="">
                    </div>
                    <div class="desc">                        
                        <div class="d-flex justify-content-between">
                            <div class="d-flex align-items-center">
                                <h5>
                                    <a href="#">@comment.UserName</a>
                                </h5>
                                <p class="date">@comment.CreatedDate.ToShamsiWithPersianMonth()</p>
                            </div>                           
                        </div>
                        <div class="d-flex justify-content-between pt-3">
                            <p class="comment">
                                @comment.Comment
                            </p>                            
                        </div>                        
                    </div>
                </div>
                <div class="reply-btn d-flex align-items-end">
                    @* <a href="#" class="btn-reply text-uppercase ">پاسخ</a> *@
                    <button class="like-button bx @((comment.Like.Any(u=>u.CreatedBy==userId)?"bxs-like":"bx-like")) like-btn"><span class="like-count font-ori">@((comment.Like.Count() == 0) ? "" : $"{comment.Like.Count()}")</span></button>
                    <button class="dislike-button bx @((comment.DisLike.Any(u=>u.CreatedBy==userId)?"bxs-dislike":"bx-dislike")) like-btn"><span class="dislike-count font-ori">@((comment.DisLike.Count() == 0) ? "" : $"{comment.DisLike.Count()}")</span></button>
                </div>
            </div>
        </div>
    }
}

