@using GreenHeart.Application.Extensions
@using GreenHeart.Application.Statics
@using GreenHeart.Domain.ViewModels.Users.Staffs.Trainers
@model ClientSideTrainerDetailViewModel
@{
    var recordcategory = Model.Experiences
        .GroupBy(e => new { e.RecordCategoryId, e.RecordCategory })
        .OrderBy(g => g.Key.RecordCategoryId);
}
<!--Start Slider-->
<div class="services-area">
    <div class="container">
        <!-- Section-tittle -->
        <div class="row d-flex justify-content-center">
            <div class="col-lg-8">
                <div class="section-tittle text-center mb-80">
                    <h1>@ViewData["Title"]​</h1>
                </div>
            </div>
        </div>
    </div>
</div>
<!--Start Slider-->
<section class="blog_area single-post-area">
    <div class="container">
        <div class="row">
            <div class="col-lg-8 posts-list">
                <div class="row">
                    <div class="col-lg-4 col-md-6 col-sm-12 order-lg-2 order-md-2 order-sm-1">
                        <div class="single-post">
                            <div class="feature-img">
                                <img class="img-fluid img-trainer-detail clickable-image"
                                     src="@SavingPath.AvatarPath@((!string.IsNullOrEmpty(Model.Avatar))?$"{Model.Avatar}":"trainer.png")"
                                     alt="@Model.Slug"
                                     data-bs-toggle="modal"
                                     data-bs-target="#imageModal">
                            </div>
                            <div class="blog_details">
                                <h2>
                                    @Model.Position
                                </h2>
                                <ul class="blog-info-link mt-3 mb-4">
                                </ul>
                                <div class="row">
                                    <div class="col-md-8">
                                        <p class="excert">
                                            <br />
                                            نام:@Model.FullName
                                            <br />
                                            ایمیل:@Model.email
                                        </p>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                    <div class="col-lg-8 col-md-6 col-sm-12 order-lg-1 order-md-1 order-sm-2">
                        <!--start-->
                        @if (Model.Experiences.CheckNullability())
                        {
                            <section class="section gray-bg" id="resume">
                                <div class="container">
                                    @* <div class="section-title"> *@
                                    <h2>@Model.Position</h2>
                                    @* </div> *@
                                    @foreach (var category in recordcategory)
                                    {
                                        <div class="row">
                                            <div class="col-12">
                                                <div class="section-title">
                                                    <h3 class="resume-head">@category.Key.RecordCategory</h3>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="row experience-tab">
                                            <div class="col-lg-12 m-15px-tb">
                                                <div class="resume-box">
                                                    <ul>
                                                        @foreach (var experince in category)
                                                        {
                                                            <li>
                                                                <div class="icon">
                                                                    <i class="fas fa-briefcase"></i>
                                                                </div>
                                                                @if (experince.HowLong != null)
                                                                {
                                                                    <span class="time">@experince.HowLong</span>
                                                                }
                                                                <h5>@experince.Title</h5>
                                                                @if (experince.ExImage != null && experince.ExImage != "")
                                                                {
                                                                    <div class="d-flex justify-content-center">
                                                                        <img src="@SavingPath.ExperiencePath@experince.ExImage" alt="@experince.Title" class="img-fluid w-75 clickable-image">
                                                                    </div>
                                                                }
                                                                @if (experince.Certificate != null)
                                                                {
                                                                    <h5>مدرک:@experince.Certificate</h5>
                                                                }
                                                                <p>@((experince.Detail != null ? "توضیحات:" : "")) @experince.Detail</p>
                                                            </li>
                                                        }
                                                    </ul>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </section>
                        }

                        <!--end-->
                    </div>
                </div>
                <div class="navigation-top">
                    <div class="d-sm-flex justify-content-between text-center">
                        <ul class="social-icons">
                            <li><a href="https://www.instagram.com/green_heart_gym/profilecard/?igsh=NDk1ZTM1Yzk2eHd3"><i class="bx bxl-instagram"></i></a></li>
                            <li><a href="https://t.me/greenheartgym"><i class="bx bxl-telegram"></i></a></li>
                        </ul>
                    </div>
                </div>

            </div>
            <div class="col-lg-4">
                <div class="blog_right_sidebar">
                    @await Component.InvokeAsync("SportExisted")
                </div>
            </div>
        </div>
    </div>
</section>