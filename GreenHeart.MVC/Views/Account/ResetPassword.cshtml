@using GreenHeart.Domain.ViewModels.Account
@model ResetPasswordViewModel
<div class="card-body">
    <h4 class="card-title">فراموشی کلمه عبور</h4>
    <form asp-controller="Account" asp-action="ResetPassword">
        <div class="form-group">
            <label asp-for="PhoneNumber" class="label-control"></label>
            <input asp-for="PhoneNumber" class="form-control" placeholder="09xxxxxxxxx">
            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="NewPassword" class="label-control"></label>
            <input type="password" asp-for="NewPassword" class="form-control form-control-lg">
            <span asp-validation-for="NewPassword" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="ConfirmNewPassword" class="label-control"></label>
            <input type="password" asp-for="ConfirmNewPassword" class="form-control form-control-lg">
            <span asp-validation-for="ConfirmNewPassword" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="VerificationCode" class="label-control"></label>
            <input type="password" asp-for="VerificationCode" class="form-control form-control-lg">
            <span asp-validation-for="VerificationCode" class="text-danger"></span>
        </div>
        <div class="form-group no-margin">
            <button type="submit" class="btn btn-primary btn-block">
                تغییر رمز عبور
            </button>
        </div>
    </form>
</div>