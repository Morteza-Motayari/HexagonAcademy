@using GreenHeart.Domain.ViewModels.Account
@model ForgotPasswordViewModel
<div class="card-body">
    <h4 class="card-title">فراموشی رمز عبور</h4>
    <form asp-controller="Account" asp-action="ForgotPassword">
        <div class="form-group">
            <label asp-for="PhoneNumber" class="label-control"></label>
            <input asp-for="PhoneNumber" class="form-control" placeholder="09xxxxxxxxx">
            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
        </div>
        <div class="form-group no-margin">
            <button type="submit" class="btn btn-primary btn-block">
                تایید
            </button>
        </div>
        <div class="text-center mt-3 small">
            تا حالا حساب در سایت ما نداشتید؟ <a asp-controller="Account" asp-action="Register" class="text-primary">ثبت نام</a>
        </div>
    </form>
</div>