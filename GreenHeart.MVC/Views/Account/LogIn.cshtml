@using GreenHeart.Domain.ViewModels.Account
@model LoginViewModel
 <div class="card-body">
    <h4 class="card-title">ورود</h4>
    <form asp-controller="Account" asp-action="LogIn">
        <div class="form-group">
            <label asp-for="PhoneNumber" class="label-control"></label>
            <input asp-for="PhoneNumber" class="form-control" placeholder="09xxxxxxxxx">
            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="Password" class="label-control"></label>
            <input type="password" asp-for="Password" class="form-control form-control-lg" placeholder="کلمه عبور">
            <span asp-validation-for="Password" class="text-danger"></span>
            <div class="text-right">
                <a asp-controller="Account" asp-action="ForgotPassword" class="small">
                    رمز عبور خود را فراموش کرده اید؟
                </a>
            </div>
        </div>
        <div class="form-group">
            <div class="row ">
                <div class="col-12">
                    <div class="input-group-prepend img-captcha">
                        <img id="img-captcha" src="~/get-captcha-image" class="img-fluid" />
                        <a onclick="resetCaptchaImage()" class="a-simp"><i class="fe fe-16 fe-rotate-cw text-primary"></i></a>
                    </div>
                </div>
                <div class="col-12 col-md-10">
                    <label class="text-label text-captcha">(لطفا متن داخل تصویر را وارد بکنید)</label>
                    <input type="text" class="form-control"  asp-for="CaptchaCode" maxlength="4" />
                    <span asp-validation-for="CaptchaCode" class="text-danger"></span>
                </div>      
            </div>
        </div>
        <div class="form-group">
            <div class="form-check">
                <label class="form-check-label text-muted">
                    <input type="checkbox" class="form-check-input h-6">
                    مرا به خاطر بسپار
                    <i class="input-helper"></i>
                </label>
            </div>
        </div>

        <div class="form-group no-margin">
            <button type="submit" class="btn btn-primary btn-block">
                ورود
            </button>
        </div>
        <div class="text-center mt-3 small">
            تا حالا حساب در سایت ما نداشتید؟ <a asp-controller="Account" asp-action="Register" class="text-primary">ثبت نام</a>
        </div>
    </form>
</div>
@section Scripts {
    <script src="/js/captcha-reload.js"></script>
}