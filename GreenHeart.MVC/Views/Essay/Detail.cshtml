@using GreenHeart.Application.Convertors
@using GreenHeart.Application.Extensions
@using GreenHeart.Application.Statics
@using GreenHeart.Domain.ViewModels.Essays.Essays
@using System.Web
@model ClientSideEssayDetaillViewModel
<!--Start Slider-->
<div class="services-area">
    <div class="container">
        <!-- Section-tittle -->
        <div class="row d-flex justify-content-center">
            <div class="col-lg-8">
                <div class="section-tittle text-center mb-80">
                    <h2>جزئیات مقاله​</h2>
                </div>
            </div>
        </div>
    </div>
</div>
<!--Start Slider-->
<section class="blog_area single-post-area">
    <div class="container">
        <div class="row">
            <div class="col-lg-8 posts-list">
                <div class="single-post">
                    <div class="feature-img">
                        <img asp-append-version="true" class="img-fluid clickable-image" src="@SavingPath.EssayPath@((!string.IsNullOrEmpty(Model.ImageUrl))?$"{Model.ImageUrl}":"defaultessay.jpeg")" alt="">
                    </div>
                    <div class="blog_details">
                        <ul class="blog-info-link mt-3 mb-4">
                            <li><a asp-area="" asp-controller="Essay" asp-action="List" asp-route-EssayCategorySlug="@Model.EssayCategorySlug"><i class='bx bx-dumbbell bxs bx-25'></i></i> @Model.EssayCategory</a></li>
@*                             <li><a href="#"><i class="bx bx-chat bxs bx-25"></i> نظرات @Model.CommentsAmount </a></li>
 *@                        </ul>
                        <div class="row">
                            <div class="col-md-8">
                                <p class="excert">
                                   @Html.Raw(Model.Content)
                            </div>
                            <div class="col-md-4">
                                تاریخ ایجاد مقاله:@Model.CreatedDate.ToShamsi()
                            </div>
                        </div>

                    </div>
                </div>

                <div class="navigation-top">
                    <div class="d-sm-flex justify-content-between text-center">
                        <ul class="social-icons">
                            <li><a href="https://www.instagram.com/green_heart_gym/profilecard/?igsh=NDk1ZTM1Yzk2eHd3"><i class="bx bxl-instagram"></i></a></li>
                            <li><a href="https://t.me/greenheartgym"><i class="bx bxl-telegram"></i></a></li>
                        </ul>
                    </div>
                </div>
                @* <div class="comments-area">
                    <button type="submit" class="btn btn-primary btn-rounded mb-4" onclick="ShowAddingCommentForm(@Model.Id)">افزودن نظر</button>
                    @await Component.InvokeAsync("ClassComments", Model.Id)
                </div> *@

            </div>
            <div class="col-lg-4">
                <div class="blog_right_sidebar">
                    @await Component.InvokeAsync("SportExisted")
                    @if (Model.KeyWords.CheckNullability())
                    {
                        <aside class="single_sidebar_widget tag_cloud_widget">
                            <h4 class="widget_title">کلمات کلیدی</h4>
                            <ul class="list">
                                @foreach (var item in Model.KeyWords)
                                {
                                    <li>
                                        <a asp-area="" asp-controller="Essay" asp-action="List" asp-route-KeyWord="@item.Key">@item.Key</a>
                                    </li>
                                }
                            </ul>
                        </aside>
                    }
                </div>
            </div>
        </div>
    </div>
</section>