@using GreenHeart.Application.Extensions
@using GreenHeart.Application.Statics
@using GreenHeart.Domain.ViewModels.Essays.EssayCategories
@using GreenHeart.Domain.ViewModels.Essays.Essays
@model ClientSideFilterEssayViewModel
@{
    List<EssayCategoryViewModel> CategoryItems = ViewData["EssayCategories"] as List<EssayCategoryViewModel> ?? new List<EssayCategoryViewModel>();
    var Categories = new SelectList(CategoryItems, "Id", "Title");
}
<div class="container-fluid service py-5">
    <div class="container py-5">
        <div class="text-center mx-auto pb-5 wow fadeInUp" data-wow-delay="0.2s" style="max-width: 800px; visibility: visible; animation-delay: 0.2s; animation-name: fadeInUp;">
            <h3 class="text-primary">مقالات ورزشی ما</h3>
            <h5 class="display-7 mb-4">در  باشگاه  <span class="text-green h4">قلب سبز</span> تلاش بر این می شود که بهترین کلاس ها برگزار بشود</h5>
            <p class="mb-0">
                
            </p>
        </div>
        <div class="row border-service p-3 mb-5 bg-body rounded-service g-4">
            <div class="col-12">
                <form class="form" method="post" id="filter-search" asp-area="" asp-controller="Essay" asp-action="List">
                    <input type="hidden" asp-for="Page" />
                    <div class="form-row row pl-4">
                        <div class="row">
                            <div class="col-12 col-sm-6 col-md-4">
                                <div class="form-group">
                                    <label asp-for="Title" class="control-label"></label>
                                    <input asp-for="Title" class="form-control form-control">
                                </div>
                            </div>
                            <div class="col-12 col-sm-6 col-md-4">
                                <div class="form-group">
                                    <label asp-for="EssayCategoryId" class="form-control-label"></label>
                                    <select asp-for="EssayCategoryId" class="form-control" asp-items="Categories">
                                        <option value="">همه</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-sm-12 padding-top">
                            <input type="submit" value="جستجو" class="btn btn-outline-success" />
                        </div>
                    </div>
                    <br />
                    <br />
                    @if (Model.Entities.CheckNullability())
                    {
                        <div class="row shadow-sm  g-4">
                            @foreach (var item in Model.Entities)
                            {
                                <div class="col-md-6 col-lg-4 wow fadeInUp" data-wow-delay="0.2s" style="visibility: visible; animation-delay: 0.2s; animation-name: fadeInUp;">
                                    <div class="service-item">
                                        <div class="service-img">
                                            <img asp-append-version="true" src="@SavingPath.EssayPath@((!string.IsNullOrEmpty(item.ImageUrl))?$"{item.ImageUrl}":"defaultessay.jpeg")" class="img-fluid rounded-top mx-auto d-block " alt="@item.Title">
                                        </div>
                                        <div class="rounded-bottom-service p-4 d-flex flex-column">
                                            <a asp-area="" asp-controller="Essay" asp-action="Detail" asp-route-slug="@item.Slug" class="h5 d-inline-block mb-4 service-a-tag">@item.Title</a>
                                            <p class="mb-4">
                                                @item.Excerpt
                                            </p>
                                            <a class="btn btn-primary rounded-pill py-2 px-4  mt-auto" asp-area="" asp-controller="Essay" asp-action="Detail" asp-route-slug="@item.Slug">جزئیات بیشتر</a>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <h3>کلاسی با مشخصات جستجو شده یافت نشد.</h3>
                    }
                </form>
                @if (Model.PageCount > 1)
                {
                    <div class="dataTables_info" role="status">نمایش @Model.StartItemFromList تا @Model.EndItemFromList از @Model.AllEntitiesCount مقاله</div>
                    <partial name="_ClientSidePaging" model="Model.GetCurrentPaging()" />
                }
            </div>

        </div>
    </div>
</div>
