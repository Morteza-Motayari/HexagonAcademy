@using GreenHeart.Application.Extensions
<!DOCTYPE html>
<html lang="fa">

<head>
    <title>@ViewData["Title"]</title>
    <partial name="_MetaTags" />
    <partial name="_StyleReferences" />
</head>

<body>
    <div class="page-wrapper">
        <!-- Header -->
        <partial name="_PageHeader" />
        <!-- Close Header -->
        <main class="page-content">
            <div class="container">
                <div class="row mb-5">
                    @await Component.InvokeAsync("UserManagementSideBar", User.GetUserId())
                    <div class="col-xl-9 col-lg-8 col-md-7">
                        @RenderBody()
                    </div>
                </div>
            </div>
        </main>
        <partial name="_Footer" />
        <partial name="_WebSiteModal" />
    </div>  
    <partial name="_JsReferences" />
    <partial name="_SiteNotification" />
    <partial name="_ImageExpandationModal" />
    @RenderSection("Scripts", false)
</body>

</html>