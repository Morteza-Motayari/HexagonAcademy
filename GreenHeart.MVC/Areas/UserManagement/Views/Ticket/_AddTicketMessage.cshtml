@using GreenHeart.Application.Extensions
@using GreenHeart.Domain.Enums.Tickets
@using GreenHeart.Domain.ViewModels.Tickets.TicketMessages
@model ClientSideCreateTicketMessageViewModel
<form asp-area="UserManagement"
      asp-controller="Ticket" asp-action="Create"
      data-ajax="true"
      data-ajax-method="post"
      data-ajax-success="OnSuccessAddingItem">
    <div class="col-md-12">
        <div class="row d-flex align-items-center">
            <div class="col-md-4 col-sm-6">
                <div class="form-element-row mb-4">
                    <label asp-for="Title" class="form-control-label"></label>
                    <input asp-for="Title" class="form-control" />
                </div>
            </div>
            <div class="col-md-4 col-sm-6">
                <div class="form-element-row mb-4">
                    <label asp-for="Section" class="form-control-label"></label>
                    <select asp-for="Section" class="form-control">
                        @foreach (var item in Enum.GetValues(typeof(TicketSection)).Cast<TicketSection>().ToList())
                        {
                            <option value="@item">@item.GetDisplayName()</option>
                        }
                    </select>
                </div>
            </div>
            <div class="col-md-4 col-sm-6">
                <div class="form-element-row mb-4">
                    <label asp-for="Priority" class="form-control-label"></label>
                    <select asp-for="Priority" class="form-control">
                        @foreach (var item in Enum.GetValues(typeof(TicketPriority)).Cast<TicketPriority>().ToList())
                        {
                            <option value="@item">@item.GetDisplayName()</option>
                        }
                    </select>
                </div>
            </div>
            <div class="col-md-12 col-sm-12">
                <div class="form-element-row mb-4">
                    <label asp-for="Message" class="form-control-label"></label>
                    <textarea asp-for="Message" class="form-control" rows="5" placeholder="پیام"></textarea>
                </div>
            </div>
            <div class="col-4 col-md-4 col-sm-4 mb-2">
                <button type="submit" class="btn btn-primary ">ایجاد تیکت</button>
            </div>
        </div>
    </div>
</form>