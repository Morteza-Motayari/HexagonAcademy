@using GreenHeart.Application.Extensions
@using GreenHeart.Domain.Enums.Wallets
@using GreenHeart.Domain.ViewModels.Wallets
@model AdminChargeWalletViewModel
<form asp-area="Admin" asp-controller="Wallet"
      asp-action="ChargeWallet" method="post"
      data-ajax="true"
      data-ajax-method="post"
      data-ajax-success="OnSuccessAddingItem">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input asp-for="UserId" type="hidden" />
    <div class="col-md-12">
        <div class="row">
            <div class="form-group col-md-10">
                <label asp-for="Price" class="form-control-label"></label>
                <input asp-for="Price" class="form-control" />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>
            <div class="form-group col-md-10">
                <label asp-for="RefId" class="form-control-label"></label>
                <input asp-for="RefId" class="form-control" />
                <span asp-validation-for="RefId" class="text-danger"></span>
            </div>
            <div class="form-group col-md-4">
                <label asp-for="Case" class="control-label"></label>
                <select asp-for="Case" class="form-control">
                    @foreach (var item in Enum.GetValues(typeof(TransactionCase)).Cast<TransactionCase>().ToList())
                    {
                        <option value="@item">@item.GetDisplayName()</option>
                    }
                </select>
            </div>
            <div class="form-group col-md-4">
                <label asp-for="Type" class="control-label"></label>
                <select asp-for="Type" class="form-control">
                    @foreach (var item in Enum.GetValues(typeof(TransactionType)).Cast<TransactionType>().ToList())
                    {
                        <option value="@item">@item.GetDisplayName()</option>
                    }
                </select>
            </div>
            <div class="form-group col-md-10">
                <label asp-for="Description" class="form-control-label"></label>
                <textarea asp-for="Description" class="form-control" ></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="form-group">
            <input type="submit" value="شارژ حساب" class="btn btn-success" />
        </div>
    </div>
</form>
