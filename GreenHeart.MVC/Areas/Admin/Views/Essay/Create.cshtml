@using GreenHeart.Application.Statics
@using GreenHeart.Domain.ViewModels.Essays.EssayCategories
@using GreenHeart.Domain.ViewModels.Essays.Essays
@model CreateEssayViewModel
@{
    List<EssayCategoryViewModel> CategoriesItems = ViewData["EssayCategories"] as List<EssayCategoryViewModel> ?? new List<EssayCategoryViewModel>();
    var Categories = new SelectList(CategoriesItems, "Id", "Title");
}
<div class="row">
    <div class="pl-3">
        <nav style="--bs-breadcrumb-divider: '>';" aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Home" asp-action="Index">خانه</a></li>
                <li class="breadcrumb-item active" aria-current="page"><a asp-area="Admin" asp-controller="Essay" asp-action="List">مقالات</a></li>
                <li class="breadcrumb-item active" aria-current="page"><a asp-area="Admin" asp-controller="Essay" asp-action="Create">افزودن مقاله</a></li>
            </ol>
        </nav>
    </div>
    <div class="col-12">
        <div class="card">
            <div class="header">
                <h2 class="mt-3">
                    <i class="fe fe-clipboard text-dark bxl"></i> @ViewData["Title"]
                </h2>
            </div>
            <div class="body">
                <form method="post" enctype="multipart/form-data" asp-area="Admin" class="row col-md-12" asp-controller="Essay" asp-action="Create">
                    <div class="col-md-12">
                        <div class="row">
                            <div class="form-group col-md-6">
                                <label asp-for="Title" class="form-control-label"></label>
                                <input asp-for="Title" class="form-control" />
                                <span asp-validation-for="Title" class="text-danger"></span>
                            </div>
                            <div class="form-group col-md-6">
                                <label asp-for="EssayCagtegoryId" class="form-control-label"></label>
                                <select asp-for="EssayCagtegoryId" id="sportval" class="form-control" asp-items="Categories">
                                    <option value="0">انتخاب گروه مقاله</option>
                                </select>
                                <span asp-validation-for="EssayCagtegoryId" class="text-danger"></span>
                            </div>
                            <div class="form-group col-md-6">
                                <div class="row ">
                                    <div class="col-md-3 text-center">
                                        <label asp-for="Image" class="control-label"></label>
                                        <div class="avatar avatar-xl contact-photo">
                                            <img id="avatar" src=@($"{SavingPath.EssayPath}defaultessay.jpeg") alt="essay" class="img-responsive">
                                        </div>
                                    </div>
                                    <div class="col">
                                        <div class="custom-file mb-3">
                                            <input asp-for="Image" id="avaterFile" type="file">
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group col-md-12">
                                <label asp-for="Excerpt" class="form-control-label"></label>
                                <input asp-for="Excerpt" class="form-control" />
                                <span asp-validation-for="Excerpt" class="text-danger"></span>
                            </div>
                            <div class="form-group col-md-12">
                                <label asp-for="Content" class="form-control-label"></label>
                                <textarea id="Content" asp-for="Content" class="form-control"></textarea>
                                <span asp-validation-for="Content" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <input type="submit" value="ایجاد مقاله" class="btn btn-success" />
                            <a asp-area="Admin" asp-controller="Essay" asp-action="List" class="btn btn-secondary">برگشت به لیست</a>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        avaterFile.onchange = evt => {
            const [file] = avaterFile.files
            if (file) {
                avatar.src = URL.createObjectURL(file)
            }
        }
    </script>>
    <script src="~/ckeditor/ckeditor.js"></script>
    <script>
        $(document).ready(function(){
            CKEDITOR.replace('Content',{
                height:300,
                filebrowserUploadUrl:'BaseSite/UploadImage',
                filebrowserBrowseUrl:'/home/UploadExplorer'
            });
        })
    </script>
}
