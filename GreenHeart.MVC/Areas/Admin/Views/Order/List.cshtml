@using GreenHeart.Application.Convertors
@using GreenHeart.Application.Extensions
@using GreenHeart.Domain.ViewModels.Orders.ClassesOrder
@model FilterOrderViewModel
@{
    ViewData["Title"] = "لیست فاکتور ها";
}
<div class="row">
    <div class="pl-3">
        <nav style="--bs-breadcrumb-divider: '>';" aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Home" asp-action="Index">خانه</a></li>
                <li class="breadcrumb-item active" aria-current="page"><a asp-area="Admin" asp-controller="Order" asp-action="List">فاکتور ها</a></li>
            </ol>
        </nav>
    </div>
    <div class="col-12">
        <div class="card">
            <div class="header">
                <h2><i class="fe fe-24 fe-zoom-in"></i> فیلترها</h2>
                <div class="toolbar">
                    <div class="col-12">
                        <form class="form" method="post" id="filter-search" asp-area="Admin" asp-controller="Order" asp-action="List">
                            <input type="hidden" asp-for="Page" />
                            <div class="form-row row pl-4">
                                <div class="col-12 col-sm-6 col-md-4">
                                    <div class="form-group">
                                        <label asp-for="UserName" class="control-label"></label>
                                        <input asp-for="UserName" class="form-control form-control">
                                    </div>
                                </div>
                                <div class="col-12 col-sm-6 col-md-2 py-2">
                                    <label class="control-label">
                                        نمایش ورودی
                                        <select asp-for="TakeEntity" aria-controls="DataTables_Table_0" class="custom-select custom-select-sm form-control form-control-sm">
                                            <option value="2">2</option>
                                            <option value="5">5</option>
                                            <option value="10">10</option>
                                            <option value="25">25</option>
                                            <option value="50">50</option>
                                            <option value="100">100</option>
                                        </select>
                                    </label>
                                </div>
                                <div class="col-12 col-sm-12 ">
                                    <input type="submit" value="جستجو" class="btn btn-outline-success" />
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
            <div class="body">
                <h2><i class="bx bxs-shopping-bags fe-24 "></i> @ViewData["Title"]</h2>
                <div class="table-responsive">
                    <div id="tableExport_wrapper" class="dataTables_wrapper dt-bootstrap4">
                        <table class="table table-borderless dataTable table-responsive w-100 d-block d-table table-hover" role="grid">
                            <thead class="thead-dark">
                                <tr role="row">
                                    <th class="center sorting" tabindex="0" aria-controls="tableExport" rowspan="1" colspan="1" aria-label="کاربر: activate to sort column ascending" style="width: 70.8875px;">کاربر</th>
                                    <th class="center sorting" tabindex="0" aria-controls="tableExport" rowspan="1" colspan="1" aria-label="مبلغ: activate to sort column ascending" style="width: 70.8875px;">مبلغ</th>
                                    <th class="center sorting" tabindex="0" aria-controls="tableExport" rowspan="1" colspan="1" aria-label="وضعیت: activate to sort column ascending" style="width: 70.8875px;">وضعیت</th>
                                    <th class="center sorting" tabindex="0" aria-controls="tableExport" rowspan="1" colspan="1" aria-label="تاریخ ایجاد: activate to sort column ascending" style="width: 70.8875px;">تاریخ ایجاد</th>
                                    <th class="center sorting" tabindex="0" aria-controls="tableExport" rowspan="1" colspan="1" aria-label="اقدام: activate to sort column ascending" style="width: 70.8875px;">اقدام</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Entities.CheckNullability())
                                {
                                    @foreach (var item in Model.Entities)
                                    {
                                        <tr role="row" class=" text-dark">
                                            <td class="center">@item.UserName</td>
                                            <td class="center">@item.TotalPrice.ToMoney()</td>                   
                                            <td class="center">
                                                @if (item.IsFainally == true)
                                                {
                                                    <span class="badge badge-success text-white">نهایی شده</span>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-danger text-white">منتظر پرداخت</span>
                                                }
                                            </td>
                                            <td class="center">@item.CreatedDate.ToShamsi()</td>
                                            <td class="center">
                                                <a asp-area="Admin" asp-controller="Order" asp-action="Detail" asp-route-id="@item.Id" class="text-secondary">
                                                    <i class="fe fe-24 fe-alert-circle text-warning"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="footer">
                <div class="dataTables_info" id="tableExport_info" role="status" aria-live="polite">نمایش @Model.StartItemFromList تا @Model.EndItemFromList از @Model.AllEntitiesCount ورودی</div>
                @if (Model.PageCount > 1)
                {
                    <partial name="_AdminPaging" model="Model.GetCurrentPaging()" />
                }
            </div>

        </div>
    </div>
</div>