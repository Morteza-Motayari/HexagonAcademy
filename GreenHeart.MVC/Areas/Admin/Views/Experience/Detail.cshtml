@using GreenHeart.Application.Convertors
@using GreenHeart.Application.Statics
@using GreenHeart.Domain.ViewModels.Records.Experiences
@model AdminSideDetailExperienceViewModel
@{
    ViewData["Title"] = "جزئیات سابقه";
}
<div class="row">
    <div class="pl-3">
        <nav style="--bs-breadcrumb-divider: '>';" aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Home" asp-action="Index">خانه</a></li>
                <li class="breadcrumb-item active" aria-current="page"><a asp-area="Admin" asp-controller="Trainer" asp-action="List">لیست مربیان</a></li>
                <li class="breadcrumb-item active" aria-current="page"><a asp-area="Admin" asp-controller="RecordCategory" asp-action="List" asp-route-staffId="@Model.StaffId">مجموعه های سوابق @Model.UserName</a></li>
                <li class="breadcrumb-item active" aria-current="page"><a asp-area="Admin" asp-controller="Experience" asp-action="Create" asp-route-staffId="@Model.StaffId" asp-route-userId="@Model.UserId" asp-route-categoryId="@Model.RecordCategoryId" asp-route-categoryName="@Model.RecordCategory">مجموعه سوابق @Model.RecordCategory</a></li>
                <li class="breadcrumb-item active" aria-current="page"><a asp-area="Admin" asp-controller="Experience" asp-action="Detail" asp-route-id="@Model.Id">جزئیات سابقه</a></li>
            </ol>
        </nav>
    </div>
    <div class="col-12">
        <div class="card">
            <div class="header">
                <h2 class="mt-3">
                    <i class="fe fe-award text-dark bxl"></i> @ViewData["Title"]
                </h2>
            </div>
            <div class="body">
                <div class="row col-md-12">
                    <div class="col-md-12">
                        <div class="row">
                            <div class="col-12">
                                <div class="col-md-9 col-lg-6  text-center">
                                    <label asp-for="ExImage" class="control-label"></label>
                                    <div class="avatar avatar-xl contact-photo">
                                        <img id="avatar" src="@SavingPath.ExperiencePath@((!string.IsNullOrEmpty(Model.ExImage))?$"{Model.ExImage}":"defaultexperience")" alt="..." class="img-responsive">
                                    </div>
                                </div>
                                @if (Model.IsDeleted == true)
                                {
                                    <div class="form-group col-md-3 col-lg-6 ">
                                        <p class="h2 mb-3 text-danger">این سابقه حذف شده است</p>
                                    </div>
                                }
                            </div>
                            <div class="form-group col-md-6">
                                <label asp-for="Title" class="form-control-label"></label>
                                <input asp-for="Title" class="form-control" disabled="" />
                            </div>
                            <div class="form-group col-md-6">
                                <label asp-for="RecordCategory" class="form-control-label"></label>
                                <input asp-for="RecordCategory" class="form-control" disabled="" />
                            </div>
                            <div class="form-group col-md-6">
                                <label asp-for="Company" class="form-control-label"></label>
                                <input asp-for="Company" class="form-control" disabled="" />
                            </div>
                            <div class="form-group col-md-6">
                                <label asp-for="HowLong" class="form-control-label"></label>
                                <input asp-for="HowLong" class="form-control" disabled="" />
                            </div>
                            <div class="form-group col-md-6">
                                <label asp-for="Certificate" class="form-control-label"></label>
                                <a class="form-control color-disabled" asp-area="Admin" asp-controller="Certificate" asp-action="Detail" asp-route-id="@Model.CertificateId">@Model.Certificate</a>
                            </div>
                            <div class="form-group col-md-6">
                                <label asp-for="UserName" class="form-control-label"></label>
                                <a class="form-control color-disabled" asp-area="Admin" asp-controller="User" asp-action="Detail" asp-route-id="@Model.UserId">@Model.UserName</a>
                            </div>
                            <div class="form-group col-md-12">
                                <label asp-for="Detail" class="form-control-label"></label>
                                <textarea asp-for="Detail" class="form-control" disabled=""></textarea>
                            </div>
                            <div class="form-group col-md-6">
                                <label asp-for="CreatedDate" class="control-label"></label>
                                <input value="@Model.CreatedDate.ToShamsiWithHour()" type="text" class="form-control" id="birthDay" disabled="">
                            </div>
                            <div class="form-group col-md-6">
                                <label asp-for="LastModifiedDate" class="control-label"></label>
                                <input value="@Model.LastModifiedDate?.ToShamsiWithHour()" type="text" class="form-control" id="birthDay" disabled="">
                            </div>
                            <div class="form-group col-md-6">
                                <label asp-for="CreatedBy" class="form-control-label"></label>
                                <a asp-area="Admin" asp-controller="User" asp-action="Detail" asp-route-id="@Model.CreatedById">@Model.CreatedBy</a>
                            </div>
                            <div class="form-group col-md-6">
                                <label asp-for="LastModifiedBy" class="form-control-label"></label>
                                <a asp-area="Admin" asp-controller="User" asp-action="Detail" asp-route-id="@Model.LastModifiedById">@Model.LastModifiedBy</a>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            @if (Model.IsDeleted == false)
                            {
                                <a asp-area="Admin" asp-controller="Experience" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">ویرایش سابقه</a>
                            }
                            <a asp-area="Admin" asp-controller="Experience" asp-action="Create" asp-route-staffId="@Model.StaffId" asp-route-userId="@Model.UserId" class="btn btn-secondary">برگشت به لیست سایقه های @Model.UserName</a>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>