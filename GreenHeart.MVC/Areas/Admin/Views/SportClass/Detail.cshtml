@using GreenHeart.Application.Convertors
@using GreenHeart.Application.Extensions
@using GreenHeart.Application.Statics
@using GreenHeart.Domain.ViewModels.Gyms.SportClasses
@model AdminSideDetailSportClassViewModel
@{
    ViewData["Title"] = "جزئیات کلاس ورزشی";
}
<div class="row">
    <div class="pl-3">
        <nav style="--bs-breadcrumb-divider: '>';" aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Home" asp-action="Index">خانه</a></li>
                <li class="breadcrumb-item active" aria-current="page"><a asp-area="Admin" asp-controller="SportClass" asp-action="List">کلاس های ورزشی</a></li>
                <li class="breadcrumb-item active" aria-current="page"><a asp-area="Admin" asp-controller="SportClass" asp-action="Detail" asp-route-id="@Model.Id">جزئیات کلاس ورزشی</a></li>
            </ol>
        </nav>
    </div>
    <div class="col-12">
        <div class="card">
            <div class="header">
                <h2 class="mt-3">
                    <i class="bx bxs-category text-dark bxl"></i> @ViewData["Title"]
                </h2>
            </div>
            <div class="body">
                <div class="row col-md-12">
                    <div class="col-md-8">
                        <div class="row">
                            <div class="form-group col-md-6">
                                <label asp-for="trainer" class="form-control-label"></label>
                                <a asp-area="Admin" asp-controller="Trainer" asp-action="Detail" class="form-control color-disabled" asp-route-id="@Model.TrainerId">@Model.trainer</a>
                            </div>
                            <div class="form-group col-md-6">
                                <label asp-for="Title" class="form-control-label"></label>
                                <input asp-for="Title" class="form-control" disabled="" />
                            </div>
                            <div class="form-group col-md-4">
                                <label asp-for="StartDate" class="form-control-label"></label>
                                <input value="@Model.StartDate.ToShamsi()" class="form-control" disabled="" />
                            </div>
                            <div class="form-group col-md-4">
                                <label asp-for="StartTime" class="form-control-label"></label>
                                <input asp-for="StartTime" class="form-control" disabled="" />
                            </div>
                            <div class="form-group col-md-4">
                                <label asp-for="EndTime" class="form-control-label"></label>
                                <input asp-for="EndTime" class="form-control" disabled="" />
                            </div>
                            <div class="form-group col-md-6">
                                <label asp-for="SubscriptionFee" class="form-control-label"></label>
                                <input value="@Model.SubscriptionFee.ToMoney()" class="form-control" disabled="" />
                            </div>
                            <div class="form-group col-md-6">
                                <label asp-for="MaxSubscription" class="form-control-label"></label>
                                <input asp-for="MaxSubscription" class="form-control" disabled="" />
                            </div>
                            <div class="form-group col-md-6">
                                <label asp-for="sport" class="form-control-label"></label>
                                <a asp-area="Admin" asp-controller="Sport" asp-action="Detail" class="form-control color-disabled" asp-route-id="@Model.SportId">@Model.sport</a>
                            </div>
                            <div class="form-group col-md-6">
                                <label asp-for="gym" class="form-control-label"></label>
                                <a asp-area="Admin" asp-controller="Gym" asp-action="Detail" class="form-control color-disabled" asp-route-id="@Model.GymId">@Model.gym</a>
                            </div>
                            <div class="form-group col-md-4">
                                <label asp-for="Gender"></label>
                                <div class="custom-radio">
                                    <input asp-for="Gender" value="@Model.Gender.GetDisplayName()" disabled="" class=" bxs">
                                </div>
                            </div>
                            <div class="form-group col-md-4">
                                <label asp-for="ClassStatus"></label>
                                <div class="custom-radio">
                                    <input asp-for="ClassStatus" value="@Model.ClassStatus.GetDisplayName()" disabled="" class=" bxs">
                                </div>
                            </div>
                            <div class="form-group col-md-4">
                                <label asp-for="RegisteredAthletes" class="control-label"></label>
                                <input asp-for="RegisteredAthletes" type="text" class="form-control" disabled="">
                            </div>
                            <div class="form-group col-md-6">
                                <label asp-for="CreatedDate" class="control-label"></label>
                                <input value="@Model.CreatedDate.ToShamsiWithHour()" type="text" class="form-control"  disabled="">
                            </div>
                            <div class="form-group col-md-6">
                                <label asp-for="LastModifiedDate" class="control-label"></label>
                                <input value="@Model.LastModifiedDate?.ToShamsiWithHour()" type="text" class="form-control" disabled="">
                            </div>
                            <div class="form-group col-md-6">
                                <label asp-for="CreatedBy" class="form-control-label"></label>
                                <a asp-area="Admin" asp-controller="User" asp-action="Detail" asp-route-id="@Model.CreatedById">@Model.CreatedBy</a>
                            </div>
                            <div class="form-group col-md-6">
                                <label asp-for="LastModifiedBy" class="form-control-label"></label>
                                <a asp-area="Admin" asp-controller="User" asp-action="Detail" asp-route-id="@Model.LastModifiedById">@Model.LastModifiedBy</a>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="row ">
                            <div class="col-md-3 text-center">
                                <label asp-for="ImageUrl" class="control-label"></label>
                                <div class="avatar avatar-xl contact-photo">
                                    <img id="avatar" src="@SavingPath.SportClassPath@((!string.IsNullOrEmpty(Model.ImageUrl))?$"{Model.ImageUrl}":"default.png")" alt="..." class="img-responsive">
                                </div>
                            </div>
                        </div>
                        @if (Model.IsDeleted == true)
                        {
                            <div class="row ">
                                <div class=" text-center">
                                    <p class="h2 mb-3 text-danger">این کلاس ورزشی حذف شده است</p>
                                </div>
                            </div>
                        }
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            @if (Model.IsDeleted == false)
                            {
                                <a asp-area="Admin" asp-controller="SportClass" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">ویرایش کلاس ورزشی</a>
                            }
                            <a asp-area="Admin" asp-controller="SportClass" asp-action="List" class="btn btn-secondary">برگشت به لیست</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

