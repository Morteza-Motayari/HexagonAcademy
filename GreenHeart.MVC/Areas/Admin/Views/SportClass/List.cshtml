@using GreenHeart.Application.Convertors
@using GreenHeart.Application.Extensions
@using GreenHeart.Domain.Enums.Filter
@using GreenHeart.Domain.Enums.SportClasses
@using GreenHeart.Domain.Enums.Users
@using GreenHeart.Domain.ViewModels.Gyms.Gyms
@using GreenHeart.Domain.ViewModels.Gyms.SportClasses
@using GreenHeart.Domain.ViewModels.Gyms.Sports
@model FilterSportClassViewModel
@{
    ViewData["Title"] = "لیست کلاس های ورزشی";
    List<GymViewModel> GymItems = ViewData["Gyms"] as List<GymViewModel> ?? new List<GymViewModel>();
    List<SportViewModel> SportItems = ViewData["Sports"] as List<SportViewModel> ?? new List<SportViewModel>();
    var Gyms = new SelectList(GymItems, "Id", "Name");
    var Sports = new SelectList(SportItems, "Id", "Title");
}
<div class="row">
    <div class="pl-3">
        <nav style="--bs-breadcrumb-divider: '>';" aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Home" asp-action="Index">خانه</a></li>
                <li class="breadcrumb-item active" aria-current="page"><a asp-area="Admin" asp-controller="SportClass" asp-action="List">کلاس های ورزشی</a></li>
            </ol>
        </nav>
    </div>
    <div class="col-12">
        <div class="card">
            <div class="header">
                <h2><i class="fe fe-24 fe-zoom-in"></i> فیلترها</h2>
                <div class="toolbar">
                    <div class="col-12">
                        <form class="form" method="post" id="filter-search" asp-area="Admin" asp-controller="SportClass" asp-action="List">
                            <input type="hidden" asp-for="Page" />
                            <div class="form-row row pl-4">
                                <div class="col-12 col-sm-6 col-md-4">
                                    <div class="form-group">
                                        <label asp-for="Title" class="control-label"></label>
                                        <input asp-for="Title" class="form-control form-control">
                                    </div>
                                </div>
                                <div class="col-12 col-sm-6 col-md-4">
                                    <div class="form-group">
                                        <label asp-for="SportId" class="form-control-label"></label>
                                        <select asp-for="SportId" class="form-control" asp-items="Sports">
                                            <option value="">همه</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-12 col-sm-6 col-md-4">
                                    <div class="form-group">
                                        <label asp-for="GymId" class="form-control-label"></label>
                                        <select asp-for="GymId" class="form-control" asp-items="Gyms">
                                            <option value="">همه</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-12 col-sm-6 col-md-4">
                                    <div class="form-group">
                                        <label asp-for="ClassStatus" class="control-label"></label>
                                        <select asp-for="ClassStatus" class="form-control">
                                            @foreach (var item in Enum.GetValues(typeof(FilterSportClassStatus)).Cast<FilterSportClassStatus>().ToList())
                                            {
                                                @if (Model.ClassStatus == item)
                                                {
                                                    <option selected value="@item">@item.GetDisplayName()</option>
                                                }
                                                else
                                                {
                                                    <option value="@item">@item.GetDisplayName()</option>
                                                }
                                            }
                                        </select>
                                    </div>
                                </div>
                                <div class="col-12 col-sm-6 col-md-4">
                                    <div class="form-group">
                                        <label asp-for="Gender" class="control-label"></label>
                                        <select asp-for="Gender" class="form-control">
                                            @foreach (var item in Enum.GetValues(typeof(FilterUserGender)).Cast<FilterUserGender>().ToList())
                                            {
                                                @if (Model.Gender == item)
                                                {
                                                    <option selected value="@item">@item.GetDisplayName()</option>
                                                }
                                                else
                                                {
                                                    <option value="@item">@item.GetDisplayName()</option>
                                                }
                                            }
                                        </select>
                                    </div>
                                </div>
                                <div class="col-12 col-sm-6 col-md-2">
                                    <div class="form-group">
                                        <label asp-for="Status" class="control-label"></label>
                                        <select asp-for="Status" class="form-control">
                                            @foreach (var item in Enum.GetValues(typeof(ExistingStatus)).Cast<ExistingStatus>().ToList())
                                            {
                                                @if (Model.Status == item)
                                                {
                                                    <option selected value="@item">@item.GetDisplayName()</option>
                                                }
                                                else
                                                {
                                                    <option value="@item">@item.GetDisplayName()</option>
                                                }
                                            }
                                        </select>
                                    </div>
                                </div>
                                <div class="col-12 col-sm-6 col-md-2 py-2">
                                    <label class="control-label">
                                        نمایش ورودی
                                        <select asp-for="TakeEntity" aria-controls="DataTables_Table_0" class="custom-select custom-select-sm form-control form-control-sm">
                                            <option value="3">3</option>
                                            <option value="5">5</option>
                                            <option value="10">10</option>
                                            <option value="25">15</option>
                                        </select>
                                    </label>
                                </div>
                                <div class="col-12 col-sm-12 ">
                                    <input type="submit" value="جستجو" class="btn btn-outline-success" />
                                </div>
                            </div>
                        </form>
                    </div>
                    <br />
                    <p class="col-12">
                        <a asp-area="Admin" asp-controller="SportClass" asp-action="Create" class="btn btn-success text-white">ایجاد کلاس ورزشی جدید</a>
                    </p>
                </div>
            </div>
            <div class="body">
                <h2><i class="bx bxs-category text-dark bxl"></i> @ViewData["Title"]</h2>
                <div class="table-responsive">
                    <div id="tableExport_wrapper" class="dataTables_wrapper dt-bootstrap4">
                        <table class="table table-borderless dataTable table-responsive w-100 d-block d-table table-hover" role="grid">
                            <thead class="thead-dark">
                                <tr role="row">
                                    <th class="center sorting" tabindex="0" aria-controls="tableExport" rowspan="1" colspan="1" aria-label="نام: activate to sort column ascending">نام </th>
                                    <th class="center sorting" tabindex="0" aria-controls="tableExport" rowspan="1" colspan="1" aria-label="هزینه اشتراک: activate to sort column ascending">هزینه اشتراک</th>
                                    <th class="center sorting" tabindex="0" aria-controls="tableExport" rowspan="1" colspan="1" aria-label="رشته ورزشی: activate to sort column ascending">رشته ورزشی</th>
                                    <th class="center sorting" tabindex="0" aria-controls="tableExport" rowspan="1" colspan="1" aria-label="باشگاه: activate to sort column ascending">باشگاه</th>
                                    <th class="center sorting" tabindex="0" aria-controls="tableExport" rowspan="1" colspan="1" aria-label="مخاطب: activate to sort column ascending">مخاطب</th>
                                    <th class="center sorting" tabindex="0" aria-controls="tableExport" rowspan="1" colspan="1" aria-label="وضعیت: activate to sort column ascending">وضعیت</th>
                                    <th class="center sorting" tabindex="0" aria-controls="tableExport" rowspan="1" colspan="1" aria-label="موجودیت: activate to sort column ascending">موجودیت</th>
                                    <th class="center sorting" tabindex="0" aria-controls="tableExport" rowspan="1" colspan="1" aria-label="تاریخ ایجاد: activate to sort column ascending">تاریخ ایجاد</th>
                                    <th class="center sorting" tabindex="0" aria-controls="tableExport" rowspan="1" colspan="1" aria-label="اقدام: activate to sort column ascending">اقدام</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Entities.CheckNullability())
                                {
                                    @foreach (var item in Model.Entities)
                                    {
                                        <tr role="row" class="@((item.IsDeleted==true)?"bg-danger":"") text-dark">
                                            <td class="center">@item.Title</td>
                                            <td class="center">@item.SubscriptionFee.ToMoney()</td>
                                            <td class="center">@item.sport</td>
                                            <td class="center">@item.gym</td>
                                            <td class="center">
                                                @if (item.Gender == UserGender.Male)
                                                {
                                                    <span class="badge badge-blue text-white">@UserGender.Male.GetDisplayName()</span>
                                                }
                                                else if (item.Gender == UserGender.Female)
                                                {
                                                    <span class="badge badge-pink text-white">@UserGender.Female.GetDisplayName()</span>
                                                }
                                            </td>
                                            <td class="center">
                                                @switch (item.ClassStatus)
                                                {
                                                    case SportClassStatus.Active:
                                                        <span class="badge badge-success text-white">@SportClassStatus.Active.GetDisplayName()</span>
                                                        break;
                                                    case SportClassStatus.NotActive:
                                                        <span class="badge badge-primary text-white">@SportClassStatus.NotActive.GetDisplayName()</span>
                                                        break;
                                                    case SportClassStatus.Closed:
                                                        <span class="badge badge-pink text-white">@SportClassStatus.Closed.GetDisplayName()</span>
                                                        break;
                                                }
                                            </td>
                                            <td class="center">
                                                @if (item.IsDeleted == true)
                                                {
                                                    <span class="badge badge-warning text-white">حذف شده</span>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-success text-white">موجود می باشد</span>
                                                }
                                            </td>
                                            <td class="center">@item.CreatedDate.ToShamsi()</td>
                                            <td class="center">                                                
                                                <a asp-area="Admin" asp-controller="SportClass" asp-action="Detail" asp-route-id="@item.Id" class="text-secondary">
                                                    <i class="fe fe-24 fe-alert-circle text-warning"></i>
                                                </a>
                                                @if (item.IsDeleted == false)
                                                {
                                                    <a asp-area="Admin" asp-controller="SportClass" asp-action="Edit" asp-route-id="@item.Id" class="text-success">
                                                        <i class="fe fe-24 fe-edit-3"></i>
                                                    </a>
                                                    <a onclick="confirmDelete('@Url.Action("Delete","SportClass",new{id=item.Id})',event,'@item.Title')" class="text-danger">
                                                        <i class="fe fe-24 fe-trash-2"></i>
                                                    </a>
                                                }
                                                else
                                                {
                                                    <a onclick="confirmDeleteForever('@Url.Action("DeleteForever","SportClass",new{id=item.Id})',event,'@item.Title')" class="text-warning">
                                                        <i class="fe fe-24 fe-trash"></i>
                                                    </a>
                                                }
                                                <a asp-area="Admin" asp-controller="KeyWord" asp-action="List" asp-route-sportClassId="@item.Id" class="text-warning">
                                                    <i class="fe fe-24 fe-key"></i>
                                                </a>
                                                <a asp-area="Admin" asp-controller="SportClass" asp-action="ClassAthletes" asp-route-SportClassId="@item.Id" class="text-primary">
                                                    <i class="fe fe-24 fe-users"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="footer">
                <div class="dataTables_info" id="tableExport_info" role="status" aria-live="polite">نمایش @Model.StartItemFromList تا @Model.EndItemFromList از @Model.AllEntitiesCount ورودی</div>
                @if (Model.PageCount > 1)
                {
                    <partial name="_AdminPaging" model="Model.GetCurrentPaging()" />
                }
            </div>

        </div>
    </div>
</div>