@using GreenHeart.Application.Convertors
@using GreenHeart.Application.Extensions
@using GreenHeart.Domain.Enums.SportClasses
@using GreenHeart.Domain.ViewModels.Gyms.ClassComments
@model AdminSideDetailClassCommentViewModel
@{
    ViewData["Title"] = "جزئیات نظر";
}
<div class="row">
    <div class="pl-3">
        <nav style="--bs-breadcrumb-divider: '>';" aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Home" asp-action="Index">خانه</a></li>
                <li class="breadcrumb-item active" aria-current="page"><a asp-area="Admin" asp-controller="ClassComment" asp-action="List">نظرات</a></li>
                <li class="breadcrumb-item active" aria-current="page"><a asp-area="Admin" asp-controller="ClassComment" asp-action="Detail" asp-route-id="@Model.Id">جزئیات نظر</a></li>
            </ol>
        </nav>
    </div>
    <div class="col-12">
        <div class="card">
            <div class="header">
                <h2 class="mt-3">
                    <i class="fe fe-message-square bxl"></i> @ViewData["Title"]
                </h2>
            </div>
            <div class="body">
                <div class="row col-md-12">
                    <div class="col-md-12">
                        <div class="row">
                            @if (Model.IsDeleted == true)
                            {
                                <div class="form-group col-md-12 ">
                                    <p class="h2 mb-3 text-danger">این نظر حذف شده است</p>
                                </div>
                            }
                            <div class="form-group col-md-6">
                                <label asp-for="SportClass" class="form-control-label"></label>
                                <a asp-area="Admin" asp-controller="SportClass" asp-action="Detail" class="form-control color-disabled" asp-route-id="@Model.ClassId">@Model.SportClass</a>
                            </div>
                            <div class="form-group col-md-6">
                                <label asp-for="CommentStatus" class="form-control-label"></label>
                                <input value="@Model.CommentStatus.GetDisplayName()" type="text" class="form-control" id="birthDay" disabled="">
                            </div>
                            <div class="form-group col-md-6">
                                <label asp-for="CreatedDate" class="control-label"></label>
                                <input value="@Model.CreatedDate.ToShamsiWithHour()" type="text" class="form-control" id="birthDay" disabled="">
                            </div>
                            <div class="form-group col-md-6">
                                <label asp-for="LastModifiedDate" class="control-label"></label>
                                <input value="@Model.LastModifiedDate?.ToShamsiWithHour()" type="text" class="form-control" id="birthDay" disabled="">
                            </div>
                            <div class="form-group col-md-6">
                                <label asp-for="CreatedBy" class="form-control-label"></label>
                                <a asp-area="Admin" asp-controller="User" asp-action="Detail" asp-route-id="@Model.CreatedById">@Model.CreatedBy</a>
                            </div>
                            <div class="form-group col-md-6">
                                <label asp-for="LastModifiedBy" class="form-control-label"></label>
                                <a asp-area="Admin" asp-controller="User" asp-action="Detail" asp-route-id="@Model.LastModifiedById">@Model.LastModifiedBy</a>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            @if (Model.IsDeleted == false)
                            {
                                @if (Model.CommentStatus != ClassCommentPending.Accepted)
                                {
                                    <button onclick="changeCommentStatus('@Url.Action("AcceptComment","ClassComment",new{id=Model.Id})')" class="btn btn-outline-success">تایید کردن</button>
                                }
                                @if (Model.CommentStatus != ClassCommentPending.Rejected)
                                {
                                    <button onclick="changeCommentStatus('@Url.Action("RejectComment","ClassComment",new{id=Model.Id})')" class="btn btn-outline-danger">رد کردن</button>
                                }
                            }
                            <a asp-area="Admin" asp-controller="ClassComment" asp-action="List" class="btn btn-secondary">برگشت به لیست</a>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script src="/adminfiles/assets/admin/admin-comment.js"></script>
}
