@using GreenHeart.Domain.Models.Users
@using GreenHeart.Domain.ViewModels.Users.Roles
@model UpdateRoleViewModel
@{
    ViewData["Title"] = "ویرایش نقش جدید";
    List<Permission> permissions = ViewData["Permissions"] as List<Permission> ?? new List<Permission>();
    List<int>? rolePermissions = Model.PermissionsId ?? new List<int>();
}
<div class="row">
    <div class="pl-3">
        <nav style="--bs-breadcrumb-divider: '>';" aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Home" asp-action="Index">خانه</a></li>
                <li class="breadcrumb-item active" aria-current="page"><a asp-area="Admin" asp-controller="Role" asp-action="List">نقش ها</a></li>
                <li class="breadcrumb-item active" aria-current="page"><a asp-area="Admin" asp-controller="Role" asp-action="Edit" asp-route-id="@Model.Id">ویرایش نقش</a></li>
            </ol>
        </nav>
    </div>
    <div class="col-12">
        <div class="card">
            <div class="header">
                <h2 class="mt-3">
                    <i class="fe fe-lock fe-24"></i> @ViewData["Title"]
                </h2>
            </div>
            <div class="body">
                <form method="post" asp-area="Admin" class="row col-md-12" asp-controller="Role" asp-action="Edit">
                <input type="hidden" asp-for="Id" />    
                <div class="row">
                        <div class="col-md-3">
                            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                            <div class="form-group">
                                <label asp-for="RoleTitle" class="control-label"></label>
                                <input asp-for="RoleTitle" class="form-control" />
                                <span asp-validation-for="RoleTitle"></span>
                            </div>
                        </div>
                        <div class="col-md-9">
                            <h2>دسترسی های نقش</h2>
                            <div class="row">
                                @foreach (var item in permissions.Where(permissions => permissions.ParentId == null))
                                {
                                    <div class="col-md-4 col-sm-6">
                                        <ul>
                                            <li>
                                                <div class="m-l-10">
                                                    <label>
                                                        <input class="form-check-input" name="PermissionsId" onclick="checkFather(@item.PermissionId)" id="father_@item.PermissionId" type="checkbox"  @((rolePermissions.Any(p=>p==item.PermissionId)?"checked":"")) value="@item.PermissionId" /> @item.PermissionTitle
                                                        <span class="form-check-sign">
                                                            <span class="check"></span>
                                                        </span>
                                                    </label>
                                                </div>
                                            </li>
                                            @if (permissions.Any(p => p.ParentId == item.PermissionId))
                                            {
                                                <ul>
                                                    @foreach (var x in permissions.Where(u => u.ParentId == item.PermissionId))
                                                    {
                                                        <li>
                                                            <div class="m-l-10">
                                                                <label>
                                                                    <input class="form-check-input child_@item.PermissionId" onclick="checkChild(@item.PermissionId)" name="PermissionsId" type="checkbox" @((rolePermissions.Any(p => p == x.PermissionId) ? "checked" : "")) value="@x.PermissionId" /> @x.PermissionTitle
                                                                    <span class="form-check-sign">
                                                                        <span class="check"></span>
                                                                    </span>
                                                                </label>
                                                            </div>
                                                        </li>
                                                    }
                                                </ul>
                                            }
                                        </ul>
                                    </div>
                                }
                                <span asp-validation-for="PermissionsId" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-10">
                            <div class="form-group">
                                <input type="submit" value="ویرایش نقش" class="btn btn-primary" />
                                <a asp-area="Admin" asp-controller="Role" asp-action="List" class="btn btn-secondary">برگشت به لیست</a>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script src="~/js/utilities.js"></script>
}