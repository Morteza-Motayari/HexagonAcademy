@using GreenHeart.Application.Statics
@using GreenHeart.Domain.ViewModels.Gyms.Gyms
@model UpdateGymViewModel
@{
    ViewData["Title"] = "ویرایش باشگاه";
}
<div class="row">
    <div class="pl-3">
        <nav style="--bs-breadcrumb-divider: '>';" aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Home" asp-action="Index">خانه</a></li>
                <li class="breadcrumb-item active" aria-current="page"><a asp-area="Admin" asp-controller="Gym" asp-action="List">باشگاه ها</a></li>
                <li class="breadcrumb-item active" aria-current="page"><a asp-area="Admin" asp-controller="Gym" asp-action="Edit" asp-route-id="@Model.Id">ویرایش باشگاه</a></li>
            </ol>
        </nav>
    </div>
    <div class="col-12">
        <div class="card">
            <div class="header">
                <h2 class="mt-3">
                    <i class="bx bx-dumbbell text-dark bxl"></i> @ViewData["Title"]
                </h2>
            </div>
            <div class="body">
                <form method="post" enctype="multipart/form-data" asp-area="Admin" class="row col-md-12" asp-controller="Gym" asp-action="Edit">
                    <input asp-for="Id" type="hidden" />
                    <input asp-for="ImageUrl" type="hidden" />

                    <div class="col-md-8">
                        <div class="row">
                            <div class="form-group col-md-6">
                                <label asp-for="Name" class="form-control-label"></label>
                                <input asp-for="Name" class="form-control" />
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>
                            <div class="form-group col-md-6">
                                <label asp-for="ConstantPhone" class="form-control-label"></label>
                                <input asp-for="ConstantPhone" class="form-control" />
                                <span asp-validation-for="ConstantPhone" class="text-danger"></span>
                            </div>
                            <div class="form-group col-md-6">
                                <label asp-for="Area" class="form-control-label"></label>
                                <input asp-for="Area" class="form-control" />
                                <span asp-validation-for="Area" class="text-danger"></span>
                            </div>
                            <div class="form-group col-md-12">
                                <label asp-for="Address" class="form-control-label"></label>
                                <textarea asp-for="Address" class="form-control"></textarea>
                                <span asp-validation-for="Address" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="row ">
                            <div class="col-md-3 text-center">
                                <label asp-for="NewImage" class="control-label"></label>
                                <div class="avatar avatar-xl contact-photo">
                                    <img id="avatar" src="@SavingPath.GymPath@((!string.IsNullOrEmpty(Model.ImageUrl))?$"{Model.ImageUrl}":"defaultgym.png")" alt="..." class="img-responsive">
                                </div>
                            </div>
                            <div class="col">
                                <div class="custom-file mb-3">
                                    <input asp-for="NewImage" id="avaterFile" type="file">
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <input type="submit" value="ویرایش باشگاه" class="btn btn-primary" />
                            <a asp-area="Admin" asp-controller="Gym" asp-action="List" class="btn btn-secondary">برگشت به لیست</a>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        avaterFile.onchange = evt => {
            const [file] = avaterFile.files
            if (file) {
                avatar.src = URL.createObjectURL(file)
            }
        }
    </script>
}