@using GreenHeart.Application.Convertors
@using GreenHeart.Application.Extensions
@using GreenHeart.Application.Statics
@using GreenHeart.Domain.ViewModels.Users.Users
@model AdminSideDetailUserViewModel

@{
    ViewData["Title"] = "جزئیات کاربر";
}
<div class="row">
    <div class="pl-3">
        <nav style="--bs-breadcrumb-divider: '>';" aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Home" asp-action="Index">خانه</a></li>
                <li class="breadcrumb-item active" aria-current="page"><a asp-area="Admin" asp-controller="User" asp-action="List">کاربران</a></li>
                <li class="breadcrumb-item active" aria-current="page"><a asp-area="Admin" asp-controller="User" asp-action="Detail" asp-route-id="@Model.Id">جزئیات کاربر</a></li>
            </ol>
        </nav>
    </div>
    <div class="col-12">
        <div class="card">
            <div class="header">
                <h2 class="mt-3">
                    <i class="bx bxs-user-detail bxl"></i> @ViewData["Title"]
                </h2>
            </div>
            <div class="body">
                <div class="row col-md-12">
                    <div class="col-md-8">
                        <div class="row">
                            <div class="form-group col-md-6">
                                <label asp-for="FirstName" class="form-control-label"></label>
                                <input asp-for="FirstName" class="form-control" disabled="" />
                            </div>
                            <div class="form-group col-md-6">
                                <label asp-for="LastName" class="form-control-label"></label>
                                <input asp-for="LastName" class="form-control" disabled="" />
                            </div><div class="form-group col-md-6">
                                <label asp-for="PhoneNumber" class="form-control-label"></label>
                                <input asp-for="PhoneNumber" class="form-control" disabled="" />
                            </div><div class="form-group col-md-6">
                                <label asp-for="Password" class="form-control-label"></label>
                                <input asp-for="Password" class="form-control" disabled="" />
                            </div><div class="form-group col-md-6">
                                <label asp-for="NationalCode" class="form-control-label"></label>
                                <input asp-for="NationalCode" class="form-control" disabled="" />
                            </div>
                            <div class="form-group col-md-6">
                                <label asp-for="city" class="form-control-label"></label>
                                <input asp-for="city" class="form-control" disabled="" />
                            </div>
                            <div class="form-group col-md-12">
                                <label asp-for="email" class="form-control-label"></label>
                                <input asp-for="email" class="form-control" disabled="" />
                            </div>
                            <div class="form-group col-md-4">
                                <label asp-for="Gender" class="form-control-label"></label>
                                <div class="custom-radio">
                                    <input asp-for="Gender" value="@Model.Gender?.GetDisplayName()" disabled="" class="form-control bxs">
                                </div>
                            </div>
                            <div class="form-group col-md-4">
                                <label asp-for="Situation" class="form-control-label"></label>
                                <input asp-for="Situation" value="@Model.Situation?.GetDisplayName()" disabled="" class="form-control bxs">
                            </div>
                            <div class="form-group col-md-4">
                                <label asp-for="Status" class="form-control-label"></label>
                                <input asp-for="Status" value="@Model.Status?.GetDisplayName()" disabled="" class="form-control bxs">
                            </div>
                            <div class="form-group col-md-8">
                                <label asp-for="BirthDay" class="form-control-label"></label>
                                <input asp-for="BirthDay" type="text" class="form-control" id="birthDay" disabled="">
                            </div>
                            <div class="form-group col-md-6">
                                <label asp-for="CreatedDate" class="control-label"></label>
                                <input value="@Model.CreatedDate.ToShamsiWithHour()" type="text" class="form-control" id="birthDay" disabled="">
                            </div>
                            <div class="form-group col-md-6">
                                <label asp-for="LastModifiedDate" class="control-label"></label>
                                <input value="@Model.LastModifiedDate?.ToShamsiWithHour()" type="text" class="form-control" id="birthDay" disabled="">
                            </div>
                            <div class="form-group col-md-6">
                                <label asp-for="CreatedBy" class="form-control-label"></label>
                                <a asp-area="Admin" asp-controller="User" asp-action="Detail" asp-route-id="@Model.CreatedById">@Model.CreatedBy</a>
                            </div>
                            <div class="form-group col-md-6">
                                <label asp-for="LastModifiedBy" class="form-control-label"></label>
                                <a asp-area="Admin" asp-controller="User" asp-action="Detail" asp-route-id="@Model.LastModifiedById">@Model.LastModifiedBy</a>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="row ">
                            <div class="col-md-3 text-center">
                                <label asp-for="Avatar" class="control-label"></label>
                                <div class="avatar avatar-xl contact-photo">
                                    <img id="avatar" src="@SavingPath.AvatarPath@((!string.IsNullOrEmpty(Model.Avatar))?$"{Model.Avatar}":"default.png")" alt="..." class="img-responsive">
                                </div>
                            </div>
                        </div>
                        @if (Model.IsDeleted == true)
                        {
                            <div class="row ">
                                <div class=" text-center">
                                    <p class="h2 mb-3 text-danger">این کاربر حذف شده است</p>
                                </div>
                            </div>
                        }
                        <br />
                        <div>
                            @if (Model.Roles.CheckNullability())
                            {
                                <h2>نقش ها</h2>
                                <hr />
                                @foreach (var item in Model.Roles)
                                {
                                    <div class="custom-checkbox">
                                        <label for="customCheck1" class="h4 mb-3">@item.RoleTitle</label>
                                    </div>
                                }
                            }
                            else
                            {
                                <p class="h2 mb-4">این کاربر هیچ نقشی ندارد</p>
                            }
                        </div>
                        @if (Model.Trainers.CheckNullability())
                        {
                            <div>
                                <h2>مربیگری ها</h2>
                                <hr />
                                <div class="custom-checkbox">
                                    @foreach (var item in Model.Trainers)
                                    {
                                        <a asp-area="Admin" asp-controller="Trainer" asp-action="Detail" class="btn mb-2 @((item.IsDeleted==true)?"btn-outline-danger":"btn-outline-primary")" asp-route-id="@item.Id">
                                            @item.Position
                                            <span class="fe fe-arrow-left fe-16 bxs"></span>
                                        </a>
                                    }
                                </div>
                            </div>
                        }
                        @if (Model.Caders.CheckNullability())
                        {
                            <div>
                                <h2>سمت ها</h2>
                                <hr />
                                <div class="custom-checkbox">
                                    @foreach (var item in Model.Caders)
                                    {
                                        <a asp-area="Admin" asp-controller="Cader" asp-action="Detail" class="btn mb-2 @((item.IsDeleted==true)?"btn-outline-danger":"btn-outline-primary")" asp-route-id="@item.Id">
                                            @item.Position
                                            <span class="fe fe-arrow-left fe-16 bxs"></span>
                                        </a>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            @if (Model.IsDeleted == false)
                            {
                                <a asp-area="Admin" asp-controller="User" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">ویرایش کاربر</a>
                            }
                            <a asp-area="Admin" asp-controller="User" asp-action="List" class="btn btn-secondary">برگشت به لیست</a>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>