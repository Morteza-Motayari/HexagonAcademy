@using GreenHeart.Domain.ViewModels.Users.Users
@model AdminChagePasswordViewModel
@{
    ViewData["Title"] = "ویرایش رمز عبور";
}
<div class="row">
    <div class="pl-3">
        <nav style="--bs-breadcrumb-divider: '>';" aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Home" asp-action="Index">خانه</a></li>
                <li class="breadcrumb-item active" aria-current="page"><a asp-area="Admin" asp-controller="User" asp-action="List">کاربران</a></li>
                <li class="breadcrumb-item active" aria-current="page"><a asp-area="Admin" asp-controller="User" asp-action="ChangePassword" asp-route-id="@Model.Id">ویرایش رمز عبور</a></li>
            </ol>
        </nav>
    </div>
    <div class="col-12">
        <div class="card">
            <div class="header">
                <h2 class="mt-3">
                    <i class="fe fe-24 fe-unlock"></i> @ViewData["Title"]
                </h2>
            </div>
            <div class="body">
                <form method="post" asp-area="Admin" class="row col-md-12" asp-controller="User" asp-action="ChangePassword">
                    <div class="col-md-8">
                        <input asp-for="Id" type="hidden" />
                        <div class="row">
                            <div class="form-group col-md-6">
                                <label asp-for="FirstName" class="form-control-label"></label>
                                <input asp-for="FirstName" class="form-control" />
                                <span asp-validation-for="FirstName" class="text-danger"></span>
                            </div>
                            <div class="form-group col-md-6">
                                <label asp-for="LastName" class="form-control-label"></label>
                                <input asp-for="LastName" class="form-control" />
                                <span asp-validation-for="LastName" class="text-danger"></span>
                            </div>
                            <div class="form-group col-md-6">
                                <label asp-for="Password" class="form-control-label"></label>
                                <input asp-for="Password" class="form-control" />
                                <span asp-validation-for="Password" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <input type="submit" value="ویرایش رمز" class="btn btn-warning" />
                            <a asp-area="Admin" asp-controller="User" asp-action="List" class="btn btn-secondary">برگشت به لیست</a>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>