@using Hexagon.Application.Extensions
@using Hexagon.Application.Statics
@using Hexagon.Domain.Enums.Filter
@using Hexagon.Domain.ViewModels.Banners
@{
    List<ClientSideBannerViewModel> banners = ViewData["banner"] as List<ClientSideBannerViewModel> ?? new List<ClientSideBannerViewModel>();
}
<!-- Start Banner Hero -->
        <!-- Start slider -->
        <div class="d-flex justify-content-center ">
    <div id="carouselExampleIndicators" class="carousel slide" data-bs-ride="carousel">
        <ol class="carousel-indicators">
            @for (int i = 0; i < banners.Count(); i++)
            {
                <li data-target="#carouselExampleIndicators" data-slide-to="@i" @((i == 0) ? "active" : "")></li>
            }
        </ol>
        <div class="carousel-inner">
            @for (int i = 0; i < banners.Count(); i++)
            {
                <div class="carousel-item @((i==0)?"active":"")">
                    <img class="d-block w-100 banner-height" src="@SavingPath.BannerPath@banners[i].BannerUrl" alt="@banners[i].BannerName">
                </div>
            }
        </div>
        <a class="carousel-control-prev text-decoration-none" href="#carouselExampleIndicators" role="button" data-bs-slide="prev">
            <i class='bx bx-chevron-right'></i>
            <span class="visually-hidden">Previous</span>
        </a>
        <a class="carousel-control-next text-decoration-none" href="#carouselExampleIndicators" role="button" data-bs-slide="next">
            <i class='bx bx-chevron-left'></i>
            <span class="visually-hidden">Next</span>
        </a>
    </div>
        </div>
        
        <!-- End slider -->
<!-- End Banner Hero -->
<!-- Start Service -->
<section class="service-wrapper py-3">
    <div class="container-fluid pb-3">
        <div class="row">
            <h2 class="h2 text-center col-12 py-5 semi-bold-600">خدمات</h2>
            <div class="service-header col-2 col-lg-3 text-end light-300">
                <i class='bx bx-dumbbell h3 mt-1'></i>
            </div>
            <div class="service-heading col-10 col-lg-9 text-start float-end light-300">
                <h2 class="h3 pb-4 typo-space-line">آکادمی ورزشی <strong class="text-success ">قلب سبز</strong></h2>
            </div>
        </div>
        <p class="service-footer col-10 offset-2 col-lg-9 offset-lg-3 text-start pb-3 text-muted px-2">
       آکادمی ورزشی برگزار کننده انواع ورزش های رزمی ، قدرتی ، وزنه برداری و غیره برای مردان و زنان می باشد.  
        </p>
    </div>

    <div class="service-tag py-5 bg-secondary">
        <div class="col-md-12">
            <ul class="nav d-flex justify-content-center">
                
                <li class="nav-item mx-lg-4">
                    <a class="filter-btn nav-link btn-outline-primary active shadow rounded-pill text-light px-4 light-300" href="#" data-filter=".All"><strong>همه</strong></a>
                </li>
                <li class="nav-item mx-lg-4">
                    <a class="filter-btn nav-link btn-outline-primary rounded-pill text-light px-4 light-300" href="#" data-filter=".Male"><strong>مردانه</strong></a>
                </li>
                <li class="filter-btn nav-item mx-lg-4">
                    <a class="filter-btn nav-link btn-outline-primary rounded-pill text-light px-4 light-300" href="#" data-filter=".Female"><strong>زنانه</strong></a>
                </li>
            </ul>
        </div>
    </div>

</section>

<section class="container overflow-hidden py-5" id="class-content">

    <partial name="_SportClasses"  model="Model"/>
</section>
<!-- End Service -->
<!-- Start View Work -->
<section class="bg-secondary">
    <div class="container py-5">
        <div class="row d-flex justify-content-center text-center">
            <div class="col-lg-2 col-12 text-light align-items-center">
                <i class='display-1 bx bxs-box bx-lg'></i>
            </div>
            <div class="col-lg-7 col-12 text-light pt-2">
                <h3 class="h4 light-300">از مروز دیگر برای خودت همراه مربی های حرفه ای برنامه ورزشی درست بکن.</h3>                
            </div>
            <div class="col-lg-3 col-12 pt-4">
                <a asp-area="" asp-controller="Trainer" asp-action="List" class="btn btn-primary rounded-pill btn-block shadow px-4 py-2">مربی ها</a>
            </div>
        </div>
    </div>
</section>
<!-- End View Work -->
<!-- Start Recent Work -->
@await Component.InvokeAsync("HomePageTrainer")
<!-- End Recent Work -->
@section Scripts {
    <script src="/js/class-loading.js"></script>
}