@using Hexagon.Application.Extensions
@using Hexagon.Domain.ViewModels.Gyms.Sports
@model List<ClientSideSportNameViewModel>
@if (Model.CheckNullability())
{
    <div class="col-lg-3 col-md-4 my-sm-0 mt-4">
        <h2 class="h4 pb-lg-3 text-light light-300">کلاس های ورزشی ما</h2>
        <ul class="list-unstyled text-light light-300">
            @foreach(var sport in Model)
            {
                <li class="pb-2">
                    <i class='bx-fw bx bxs-chevron-left bx-xs'></i><a class="text-decoration-none text-light py-1" asp-area="" asp-controller="SportClass" asp-action="List" asp-route-SportSlug="@sport.Slug">@sport.Title</a>
                </li>
            }
        </ul>
    </div>
}
