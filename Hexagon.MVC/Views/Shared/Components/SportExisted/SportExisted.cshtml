@using Hexagon.Domain.ViewModels.Gyms.Sports
@model List<ClientSideSportExisted>
@{
    int sportId = (int)ViewData["sportId"];
}
<aside class="single_sidebar_widget post_category_widget">
    <h4 class="widget_title">کلاس های ورزشی موجود</h4>
    <ul class="list cat-list">
        @foreach(var item in Model)
        {
            <li class="@((item.Id==sportId)?"active":"")">
                <a asp-area="" asp-controller="SportClass" asp-action="List" asp-route-SportSlug="@item.Slug" class="d-flex justify-content-between align-items-center">
                    <p class="mb-0">@item.Title</p>
                    <span class="ml-auto">(@item.Classes)</span>
                </a>
            </li>
        }
    </ul>
</aside>