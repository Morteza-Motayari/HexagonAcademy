@using Hexagon.Domain.ViewModels.Gyms.Sports
@model List<ClientSideSportExisted>
<aside class="single_sidebar_widget post_category_widget">
    <h4 class="widget_title">کلاس های وزرشی موجود</h4>
    <ul class="list cat-list">
        @foreach(var item in Model)
        {
            <li>
                <a asp-area="" asp-controller="SportClass" asp-action="List" asp-route-SportSlug="@item.Slug" class="d-flex">
                    <p>@item.Title</p>
                    <p>(@item.Classes)</p>
                </a>
            </li>
        }
    </ul>
</aside>