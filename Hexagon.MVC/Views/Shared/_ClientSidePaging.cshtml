@using Hexagon.Domain.ViewModels.Common
@model PagingViewModel
@if (Model.PageCount > 1)
{
    <div class="row">
        <div class="col-12">
            <nav class="border-top py-4">
                <ul class="pagination justify-content-center fa-num">
                    <li class="service-page-item @((Model.StartPage==Model.Page)?"disabled":"")">
                        <a class="service-page-link" onclick="fillPageId('@Model.Page'-1)" aria-label="Previous">
                            <i class='bx bx-chevron-right'></i>
                        </a>
                    </li>
                    @for(int i = Model.StartPage; i <= Model.EndPage; i++)
                    {
                        <li class="service-page-item @((i == Model.Page) ? "active" : "")">
                            <a class="service-page-link" onclick="fillPageId('@i')">
                                @i
                            </a>
                        </li>
                    }
                    <li class="service-page-item @((Model.EndPage==Model.Page)?"disabled":"")" >
                        <a class="service-page-link" onclick="fillPageId(+'@Model.Page' + +1)" aria-label="Next">
                            <i class='bx bx-chevron-left'></i>
                        </a>
                    </li>
                </ul>
            </nav>
        </div>
    </div>
}