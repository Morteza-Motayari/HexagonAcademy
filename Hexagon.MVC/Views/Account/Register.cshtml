@using Hexagon.Domain.ViewModels.Account
@model RegisterViewModel
<div class="card-body">
    <h4 class="card-title">ثبت نام</h4>
    <form asp-controller="Account" asp-action="Register">
        <div class="form-group">
            <label asp-for="PhoneNumber" class="label-control"></label>
            <input asp-for="PhoneNumber" class="form-control" placeholder="09xxxxxxxxx">
            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="Password" class="label-control"></label>
            <input type="password" asp-for="Password" class="form-control form-control-lg" >
            <span asp-validation-for="Password" class="text-danger"></span>            
        </div>
        <div class="form-group">
            <label asp-for="ConfirmPassword" class="label-control"></label>
            <input type="password" asp-for="ConfirmPassword" class="form-control form-control-lg" >
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        </div>
        <div class="form-group no-margin">
            <button type="submit" class="btn btn-primary btn-block">
                ثبت نام
            </button>
        </div>
        <div class="text-center mt-3 small">
            آیا قبلا ثبت نام کرده اید؟ <a asp-controller="Account" asp-action="LogIn" class="text-primary">ورود</a>
        </div>
    </form>
</div>
