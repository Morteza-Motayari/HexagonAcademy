<div class="card-body">
    <h4 class="card-title">تست</h4>
    <form asp-controller="Account" asp-action="Test">
        <div class="form-group">
            <label class="label-control">شماره موبایل</label>
            <input name="PhoneNumber" class="form-control" placeholder="09xxxxxxxxx" />
        </div>
        <div class="form-group no-margin">
            <button type="submit" class="btn btn-primary btn-block">
                ثبت تست
            </button>
        </div>
        <div class="text-center mt-3 small">
            آیا قبلا ثبت نام کرده اید؟ <a asp-controller="Account" asp-action="LogIn" class="text-primary">ورود</a>
        </div>
    </form>
</div>
