@using Hexagon.Domain.ViewModels.Gyms.ClassComments
@model ClientSideCreateCommentViewModel
<form asp-area="" asp-controller="ClassComment" asp-action="CreateComment"
      method="post"
      data-ajax="true"
      data-ajax-method="post"
      data-ajax-success="OnSuccessAddingItem">
    <input type="hidden" asp-for="ClassId" />
    <div class="row">
        <div class="col-12">
            <div class="form-group">
                <textarea class="form-control " asp-for="Comment" cols="30" rows="5" placeholder="متن نظرتان را بنویسید"></textarea>
            </div>
        </div>
    </div>
    <div class="form-group mt-3">
        <input type="submit" value="افزودن" class="btn btn-success " />
    </div>
</form>