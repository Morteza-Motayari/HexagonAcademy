@using Hexagon.Application.Convertors
@using Hexagon.Application.Extensions
@using Hexagon.Application.Statics
@using Hexagon.Domain.ViewModels.Gyms.SportClasses
@using Hexagon.Domain.ViewModels.Orders.ClassesOrder
@model ClientSideSportClassDeatilViewModel
<!--Start Slider-->
<div class="services-area">
    <div class="container">
        <!-- Section-tittle -->
        <div class="row d-flex justify-content-center">
            <div class="col-lg-8">
                <div class="section-tittle text-center mb-80">
                    <h2>جزئیات کلاس​</h2>
                </div>
            </div>
        </div>
    </div>
</div>
<!--Start Slider-->
<section class="blog_area single-post-area">
    <div class="container">
        <div class="row">
            <div class="col-lg-8 posts-list">
                <div class="single-post">
                    <div class="feature-img">
                        <img class="img-fluid" src="@SavingPath.SportClassPath@((!string.IsNullOrEmpty(Model.ImageUrl))?$"{Model.ImageUrl}":"defaultClass.jpg")" alt="">
                    </div>
                    <div class="blog_details">
                        <h2>
                            @Model.Title
                        </h2>
                        <ul class="blog-info-link mt-3 mb-4">
                            <li><a asp-area="" asp-controller="SportClass" asp-action="List" asp-route-SportSlug="@Model.SportSlug"><i class='bx bx-dumbbell bxs bx-25'></i></i> @Model.sport</a></li>
                            <li><a href="#"><i class="bx bx-chat bxs bx-25"></i> نظرات @Model.CommentsAmount </a></li>
                        </ul>
                        <div class="row">
                            <div class="col-md-8">
                                <p class="excert">
                                    مربی:<a asp-area="" asp-controller="Trainer" asp-action="Detail" asp-route-Slug="@Model.TrainerSlug">@Model.Trainer</a>
                                    <br />
                                    مخاطب:@Model.Gender.GetDisplayName()
                                    <br />
                                    تاریخ ایجاد کلاس:@Model.StartDate.ToShamsi()
                                    <br />
                                    ساعت برگزاری کلاس:@Model.StartTime.ToHoure() تا @Model.EndTime.ToHoure()
                                    <br />
                                    هزینه کلاس:@Model.SubscriptionFee.ToMoney() ریال
                                    <br />
                                    محل برگزاری:@Model.gym
                                </p>
                            </div>
                            <div class="col-md-4">
                                @if (Model.IsRegisterted == true&&!Model.RegistraionDate.OneMonthPassed())
                                {
                                    <a asp-area="UserManagement" asp-controller="SportClass" asp-action="List" class="btn btn-success w-100">شما در این کلاس شرکت کرده اید</a>
                                }
                                else
                                {                                
                                <partial name="_AddClassToOrder" model="@(new CreateClassOrderViewModel(){
Price=(int)Model.SubscriptionFee,
Gender=Model.Gender,
ClassId=Model.Id,
ClassSlug=Model.slug,
IsRegisterted=Model.IsRegisterted
})" />
                                }
                            </div>
                        </div>

                    </div>
                </div>

                <div class="navigation-top">
                    <div class="d-sm-flex justify-content-between text-center">
                        <ul class="social-icons">
                            <li><a href="https://www.instagram.com/green_heart_gym/profilecard/?igsh=NDk1ZTM1Yzk2eHd3"><i class="bx bxl-instagram"></i></a></li>
                            <li><a href="https://t.me/greenheartgym"><i class="bx bxl-telegram"></i></a></li>
                        </ul>
                    </div>
                </div>
                <div class="comments-area">
                    <button type="submit" class="btn btn-primary btn-rounded mb-4" onclick="ShowAddingCommentForm(@Model.Id)">افزودن نظر</button>
                    @await Component.InvokeAsync("ClassComments", Model.Id)
                </div>

            </div>
            <div class="col-lg-4">
                <div class="blog_right_sidebar">
                    @await Component.InvokeAsync("SportExisted",Model.SportId)
                    @if (Model.KeyWords.CheckNullability())
                    {
                        <aside class="single_sidebar_widget tag_cloud_widget">
                            <h4 class="widget_title">کلمات کلیدی</h4>
                            <ul class="list">
                                @foreach (var item in Model.KeyWords)
                                {
                                    <li>
                                        <a asp-area="" asp-controller="SportClass" asp-action="List" asp-route-KeyWord="@item.Key">@item.Key</a>
                                    </li>
                                }
                            </ul>
                        </aside>
                    }
                </div>
            </div>
        </div>
    </div>
</section>
@section Scripts {
    <script src="/js/custom-comment.js"></script>
}