@using Hexagon.Domain.ViewModels.Orders.ClassesOrder
@model CreateClassOrderViewModel
<form asp-area="UserManagement" asp-controller="Order" asp-action="AddClassToOrder" method="post">
    <input asp-for="ClassId" type="hidden" />
    <input asp-for="Price" type="hidden" />
    <input asp-for="Gender" type="hidden" />
    <input asp-for="ClassSlug" type="hidden" />
    <button type="submit" class="btn btn-outline-primary w-100">
        @((Model.IsRegisterted == true) ? "تمدید کلاس" : "شرکت کردن در کلاس")
    </button>
</form>