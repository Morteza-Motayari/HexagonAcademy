@using Hexagon.Application.Extensions
@using Hexagon.Application.Statics
@using Hexagon.Domain.ViewModels.Users.Staffs.Trainers
@model ClientSideTrainerDetailViewModel
@{
    ViewData["Title"] = "جزئیات مربی";
}
<!--Start Slider-->
<div class="services-area">
    <div class="container">
        <!-- Section-tittle -->
        <div class="row d-flex justify-content-center">
            <div class="col-lg-8">
                <div class="section-tittle text-center mb-80">
                    <h2>@ViewData["Title"]​</h2>
                </div>
            </div>
        </div>
    </div>
</div>
<!--Start Slider-->
<section class="blog_area single-post-area">
    <div class="container">
        <div class="row">
            <div class="col-lg-8 posts-list">
                <div class="single-post">
                    <div class="feature-img">
                        <img class="img-fluid" src="@SavingPath.AvatarPath@((!string.IsNullOrEmpty(Model.Avatar))?$"{Model.Avatar}":"trainer.png")" alt="@Model.Slug">
                    </div>
                    <div class="blog_details">
                        <h2>
                            @Model.Position
                        </h2>
                        <ul class="blog-info-link mt-3 mb-4">
                        </ul>
                        <div class="row">
                            <div class="col-md-8">
                                <p class="excert">
                                    <br />
                                    نام:@Model.FullName
                                    <br />
                                    ایمیل:@Model.email
                                </p>
                            </div>
                        </div>

                    </div>
                </div>
                <!--start-->
                @if (Model.Experiences.CheckNullability())
                {
                    <section class="section gray-bg" id="resume">
                        <div class="container">
                            <div class="row">
                                <div class="col-12">
                                    <div class="section-title">
                                        <h2>سابقه ها</h2>
                                        <p>@Model.Position</p>
                                    </div>
                                </div>
                            </div>
                            <div class="row experience-tab">
                                <div class="col-lg-6 m-15px-tb">
                                    <div class="resume-box">
                                        <ul>
                                            @foreach(var experince in Model.Experiences)
                                            {
                                                <li>
                                                    <div class="icon">
                                                        <i class="fas fa-briefcase"></i>
                                                    </div>
                                                    <span class="time">@experince.HowLong</span>
                                                    <h5>@experince.Title</h5>
                                                    @if (experince.Certificate!=null){
                                                        <h5>مدرک:@experince.Certificate</h5>
                                                    }
                                                    <p>@((experince.Detail!=null?"توضیحات:":"")) @experince.Detail</p>
                                                </li>
                                            }                                            
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                }
                
                <!--end-->
                <div class="navigation-top">
                    <div class="d-sm-flex justify-content-between text-center">
                        <ul class="social-icons">
                            <li><a href="#"><i class="bx bxl-instagram"></i></a></li>
                            <li><a href="#"><i class="bx bxl-telegram"></i></a></li>
                        </ul>
                    </div>
                </div>

            </div>
            <div class="col-lg-4">
                <div class="blog_right_sidebar">
                    @await Component.InvokeAsync("SportExisted")
                </div>
            </div>
        </div>
    </div>
</section>