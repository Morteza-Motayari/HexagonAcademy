@using Hexagon.Application.Convertors
@using Hexagon.Application.Extensions
@using Hexagon.Application.Statics
@using Hexagon.Domain.Enums.SportClasses
@using Hexagon.Domain.ViewModels.Gyms.SportClasses
@using Hexagon.Domain.ViewModels.Orders.ClassesOrder
@model UserSideFilterSportClassViewModel
@{
    ViewData["Tilte"] = "کلاس ها";
}
<div class="card shadow mb-4 ui-box-profile">
    <div class="card-header">
        <strong class="card-title">
            <i class='bx bxs-category bxs'></i> @ViewData["Tilte"]
        </strong>
    </div>
    @if (Model.Entities.CheckNullability())
    {
        <div class="row card-deck g-4">
            <form method="post" id="filter-search" asp-area="UserManagement" asp-controller="SportClass" asp-action="List">
                <input type="hidden" asp-for="Page" />
            </form>
            @foreach (var item in Model.Entities)
            {
                <div class="col-lg-4 col-md-6 col-sm-6">
                    <div class="card">
                        <img class="img-fluid rounded-top mx-auto d-block img-panel-comment" src="@SavingPath.SportClassPath@((!string.IsNullOrEmpty(item.ImageUrl))?$"{item.ImageUrl}":"defaultClass.jpg")" alt="@item.Title">
                        <div class="card-body">
                            <h5 class="card-title card-height"><a asp-area="" asp-controller="SportClass" asp-action="Detail" asp-route-slug="@item.slug">@item.Title</a></h5>
                            <ul class="list-group">
                                <li class="list-group-item list-group-item-success"><i class="fa fa-briefcase" style="font-size:20px;"></i>ساعت کلاس:@item.StartTime.ToHoure() تا @item.EndTime.ToHoure()</li>
                                <li class="list-group-item list-group-item-success">
                                    <i class="fa fa-user" style="font-size:20px;"></i>تاریخ ثبت نام:@item.RegistraionDate.ToShamsiWithPersianMonth()
                                </li>
                                <li class="list-group-item list-group-item-success">
                                    <i class="fa fa-briefcase" style="font-size:20px;"></i>وضعیت کلاس:
                                    @switch (item.Status)
                                    {
                                        case SportClassStatus.NotActive:
                                            <span class="badge bg-yellow rounded-pill">@item.Status.GetDisplayName()</span>
                                            break;
                                        case SportClassStatus.Active:
                                            <span class="badge bg-primary rounded-pill">@item.Status.GetDisplayName()</span>
                                            break;
                                        case SportClassStatus.Closed:
                                            <span class="badge bg-danger rounded-pill">@item.Status.GetDisplayName()</span>
                                            break;
                                    }
                                </li>
                            </ul>
                        </div>
                        <div class="card-footer d-flex justify-content-center ">
                            @if (!item.ExtensionDate.OneMonthPassed())
                            {
@*                                 <a asp-area="" asp-controller="SportClass" asp-action="Detail" asp-route-slug="@item.slug" class="btn btn-success w-100">@item.Title</a>
 *@                            }
                            else
                            {
                                <partial name="~/Views/SportClass/_AddClassToOrder.cshtml" model="@(new CreateClassOrderViewModel(){
Price=(int)item.SubscriptionFee,
Gender=item.Gender,
ClassId=item.ClassId,
ClassSlug=item.slug,
IsRegisterted=true
})" />
                            }
                            
                        </div>
                    </div>
                </div>
            }
        </div>
        <div class="sep"></div>
        @if (Model.PageCount > 1)
        {
            <div class="dataTables_info" role="status">نمایش @Model.StartItemFromList تا @Model.EndItemFromList از @Model.AllEntitiesCount کلاس</div>
            <partial name="_ClientSidePaging" model="Model.GetCurrentPaging()" />
        }
    }
    else
    {
        <div>
            <strong>شما هیچ کلاسی ندارید</strong>
        </div>
    }
</div>
@section Scripts {
    <script src="/js/client-custom.js"></script>
    <script src="/js/custom-comment.js"></script>
}
