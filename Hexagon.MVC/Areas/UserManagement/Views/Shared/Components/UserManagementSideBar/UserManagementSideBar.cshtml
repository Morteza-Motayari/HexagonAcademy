@using Hexagon.Application.Extensions
@using Hexagon.Application.Services.Interfaces.Users
@using Hexagon.Application.Statics
@using Hexagon.Domain.ViewModels.Users.Users
@inject IStaffService staffService
@model UserClientSideView
@{
    int userId = User.GetUserId();
    int budget = (int)ViewData["Budget"];
}
<div class="col-xl-3 col-lg-4 col-md-5 mb-md-0 mb-4 row-pannel-inner">
    <div class="ui-sticky ui-sticky-top">
        <div class="profile-user-info py-3 ui-box-pannel  bg-white">
            <div class="profile-detail">
                <div class="d-flex align-items-center">
                    <div class="profile-avatar me-3">
                        <img src="@SavingPath.AvatarPath@((!string.IsNullOrEmpty(Model.Avatar))?$"{Model.Avatar}":"default.png")" alt="avatar">
                    </div>
                    <div class="profile-info">
                        <a asp-area="UserManagement" asp-controller="Home" asp-action="Index" class="text-decoration-none text-dark fw-bold mb-2">
                            @Model.GetUserName()
                        </a>
                        <div class="text-muted fs-7 fw-bold">@Model.PhoneNumber</div>
                    </div>
                </div>
                <div class="user-options">
                    <ul class="decor-ul">
                        <li>
                            <span class="label">کیف پول</span>
                            <span class="detail">
                                <span class="d-block">@budget.ToMoney() <span class="currency fs-7 fw-bold">ریال</span></span>
                                <a asp-area="UserManagement" asp-controller="Wallet" asp-action="List" class="link border-bottom-0 text-info fs-7 fw-bold link-decor">
                                    افزایش
                                    موجودی <i class='bx bx-chevron-left'></i>
                                </a>
                            </span>
                        </li>
                    </ul>
                </div>
            </div>
            <ul class="nav nav-items-with-icon flex-column decor-ul">
                @if (await staffService.UserHasPermission(userId))
                {
                    <li class="nav-item">
                        <a class="nav-link nav-decor" asp-area="Admin" asp-controller="Home" asp-action="Index">
                            <i class="nav-link-icon bx bx-laptop bxs"></i>
                            مدیریت سایت
                        </a>
                    </li>
                }
                <li class="nav-item">
                    <a class="nav-link nav-decor" asp-area="UserManagement" asp-controller="SportClass" asp-action="List">
                        <i class="nav-link-icon bx bxs-category bxs"></i>
                        کلاس
                        های من
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-area="UserManagement" asp-controller="Ticket" asp-action="List">
                        <i class='bx bx-conversation bxs'></i>
                        تیکت ها
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-area="UserManagement" asp-controller="ClassComment" asp-action="List">
                        <i class="bx bx-chat bxs"></i>
                        نظرات
                    </a>
                </li>
                <li class="nav-item">
                    
                    <a class="nav-link" asp-area="UserManagement" asp-controller="Order" asp-action="List">
                        <i class='bx bxs-shopping-bags bxs'></i> فاکتورها
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-area="UserManagement" asp-controller="Wallet" asp-action="List">
                        <i class='bx bx-wallet bxs'></i>تراکنش ها
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-area="UserManagement" asp-controller="User" asp-action="EditProfile">
                        <i class='bx bxs-user-detail bxs'></i> اطلاعات
                        حساب
                    </a>
                </li>
                <a class="nav-link nav-decor" asp-controller="Account" asp-action="LogOut">
                    <i class="nav-link-icon bx bx-log-out bxs"></i>
                    خروج
                </a>
            </ul>
        </div>
    </div>
</div>