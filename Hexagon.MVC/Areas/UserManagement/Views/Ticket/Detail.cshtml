@using Hexagon.Application.Convertors
@using Hexagon.Application.Extensions
@using Hexagon.Application.Statics
@using Hexagon.Domain.Enums.Tickets
@using Hexagon.Domain.ViewModels.Tickets.TicketMessages
@model List<ClientSideTicketMessageViewModel>
@{
    ViewData["Tilte"] = "تیکت ها";
    int userId = User.GetUserId();
    string avatar = (string)ViewData["userAvatar"]??null;
    int ticketid = (int)ViewData["TicketId"];
    TicketStatus status = (TicketStatus)ViewData["TicketStatus"];
}
<div class="card shadow mb-4 ui-box-profile">
    <div class="card-header">
        <strong class="card-title">
            <i class='bx bx-conversation bxs'></i>@ViewData["Tilte"]
        </strong>
    </div>
    <div class="card-body">
        <div class="container">
            <!-- Content wrapper start -->
            <div class="content-wrapper">

                <!-- Row start -->
                <div class="row gutters">

                    <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">

                        <div class="card m-0">

                            <!-- Row start -->
                            <div class="row no-gutters">
                                <div class="col-12">
                                    <div class="selected-user">
                                        <span>موضوع: <span class="name">@ViewData["TicketTitle"]</span></span>
                                    </div>
                                    <div class="chat-container">
                                        <ul class="chat-box chatContainerScroll">
                                            @if (Model.CheckNullability())
                                            {
                                                foreach(var message in Model)
                                                {
                                                    @if (message.SenderId == userId)
                                                    {
                                                        <li class="chat-left">
                                                            <div class="chat-avatar">                                                         
                                                                    <img src="@SavingPath.AvatarPath@((!string.IsNullOrEmpty(avatar))?$"{avatar}":"default.png")" alt="Retail Admin">
                                                                <div class="chat-name">خودم</div>
                                                            </div>
                                                            <div class="chat-text">
                                                                @message.Message
                                                                <br>
                                                                    <a onclick="DeleteTicketMessage('@message.TicketMessageId',event)"><i class='bx bx-message-rounded-x text-danger'></i></a>                                                
                                                            </div>
                                                            <div class="chat-hour">@message.CreatedDate.ToShamsiWithPersianMonth()<span class="fa fa-check-circle"></span></div>
                                                        </li>
                                                    }
                                                    else
                                                    {
                                                        <li class="chat-right">
                                                            <div class="chat-hour">@message.CreatedDate.ToShamsiWithPersianMonth()<span class="fa fa-check-circle"></span></div>
                                                            <div class="chat-text">
                                                                @message.Message
                                                                <br> 
                                                            </div>
                                                            <div class="chat-avatar">
                                                                <img src="~/Images/Avatars/default.png" alt="admin">
                                                                <div class="chat-name">کادر باشگاه</div>
                                                            </div>
                                                        </li>
                                                    }
                                                }
                                            }
                                        </ul>
                                        <div class="form-group mt-3 mb-0">
                                            @if (status != TicketStatus.Close)
                                            {
                                                <form method="post" asp-area="UserManagement" asp-controller="Ticket" asp-action="Response">
                                                    <input type="hidden" name="TicketId" value="@ticketid" />
                                                    <textarea name="ResponseTicket" class="form-control" rows="4" placeholder="بازخورد خود را این جا بنویسید"></textarea>
                                                    <button type="submit" class="btn btn-block btn-success">ثبت</button>
                                                </form>
                                            }
                                            else
                                            {
                                                <div class="alert alert-warning alert-dismissible fade show mb-5" role="alert">
                                                    <div>
                                                        این تیکت بسته شده است و امکان ارسال پیام دیگری در آن وجود دارد.
                                                    </div>
                                                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                                                </div>
                                            }                                       
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <!-- Row end -->
                        </div>

                    </div>

                </div>
                <!-- Row end -->

            </div>
            <!-- Content wrapper end -->

        </div>
    </div>
</div>
@section Scripts {
    <script src="/js/add-ticket.js"></script>
}