@using Hexagon.Application.Convertors
@using Hexagon.Application.Extensions
@using Hexagon.Domain.Enums.Filter
@using Hexagon.Domain.Enums.Users
@using Hexagon.Domain.ViewModels.Users.Users
@model FilterUserViewModel
@{
    ViewData["Title"] = "لیست کاربران";
}
<div class="row">
    <div class="pl-3">
        <nav style="--bs-breadcrumb-divider: '>';" aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Home" asp-action="Index">خانه</a></li>
                <li class="breadcrumb-item active" aria-current="page"><a asp-area="Admin" asp-controller="User" asp-action="List">کاربران</a></li>
            </ol>
        </nav>
    </div>
    <div class="col-12">
        <div class="card">
            <div class="header">
                <h2><i class="fe fe-24 fe-zoom-in"></i> فیلترها</h2>
                <div class="toolbar">
                    <div class="col-12">
                        <form class="form" method="post" id="filter-search" asp-area="Admin" asp-controller="User" asp-action="List">
                            <input type="hidden" asp-for="Page" />
                            <div class="form-row row pl-4">
                                <div class="col-12 col-sm-6 col-md-4">
                                    <div class="form-group">
                                        <label asp-for="Name" class="control-label"></label>
                                        <input asp-for="Name" class="form-control form-control">
                                    </div>
                                </div>
                                <div class="col-12 col-sm-6 col-md-4">
                                    <div class="form-group">
                                        <label asp-for="PhoneNumber" class="control-label"></label>
                                        <input asp-for="PhoneNumber" class="form-control form-control">
                                    </div>
                                </div>
                                <div class="col-12 col-sm-6 col-md-2 py-2">
                                    <label class="control-label">
                                        نمایش ورودی
                                        <select asp-for="TakeEntity" aria-controls="DataTables_Table_0" class="custom-select custom-select-sm form-control form-control-sm">
                                            <option value="2">2</option>
                                            <option value="5">5</option>
                                            <option value="10">10</option>
                                            <option value="25">25</option>
                                            <option value="50">50</option>
                                            <option value="100">100</option>
                                        </select>
                                    </label>
                                </div>
                                <div class="col-12 col-sm-6 col-md-2">
                                    <div class="form-group">
                                        <label asp-for="Status" class="control-label"></label>
                                        <select asp-for="Status" class="form-control">
                                            @foreach (var item in Enum.GetValues(typeof(ExistingStatus)).Cast<ExistingStatus>().ToList())
                                            {
                                                @if (Model.Status == item)
                                                {
                                                    <option selected value="@item">@item.GetDisplayName()</option>
                                                }
                                                else
                                                {
                                                    <option value="@item">@item.GetDisplayName()</option>
                                                }
                                            }
                                        </select>
                                    </div>
                                </div>
                                <div class="col-12 col-sm-6 col-md-4">
                                    <div class="form-group">
                                        <label asp-for="userStatus" class="control-label"></label>
                                        <select asp-for="userStatus" class="form-control">
                                            @foreach (var item in Enum.GetValues(typeof(FilterUserStatus)).Cast<FilterUserStatus>().ToList())
                                            {
                                                @if (Model.userStatus == item)
                                                {
                                                    <option selected value="@item">@item.GetDisplayName()</option>
                                                }
                                                else
                                                {
                                                    <option value="@item">@item.GetDisplayName()</option>
                                                }
                                            }
                                        </select>
                                    </div>
                                </div>
                                <div class="col-12 col-sm-6 col-md-4">
                                    <div class="form-group">
                                        <label asp-for="Situation" class="control-label"></label>
                                        <select asp-for="Situation" class="form-control">
                                            @foreach (var item in Enum.GetValues(typeof(FilterUserSituation)).Cast<FilterUserSituation>().ToList())
                                            {
                                                @if (Model.Situation == item)
                                                {
                                                    <option selected value="@item">@item.GetDisplayName()</option>
                                                }
                                                else
                                                {
                                                    <option value="@item">@item.GetDisplayName()</option>
                                                }
                                            }
                                        </select>
                                    </div>
                                </div>
                                <div class="col-12 col-sm-6 col-md-4">
                                    <div class="form-group">
                                        <label asp-for="Gender" class="control-label"></label>
                                        <select asp-for="Gender" class="form-control">
                                            @foreach (var item in Enum.GetValues(typeof(FilterUserGender)).Cast<FilterUserGender>().ToList())
                                            {
                                                @if (Model.Gender == item)
                                                {
                                                    <option selected value="@item">@item.GetDisplayName()</option>
                                                }
                                                else
                                                {
                                                    <option value="@item">@item.GetDisplayName()</option>
                                                }
                                            }
                                        </select>
                                    </div>
                                </div>
                                <div class="col-12 col-sm-12 ">
                                    <input type="submit" value="جستجو" class="btn btn-outline-success" />
                                </div>
                            </div>
                        </form>
                    </div>
                    <br />
                    <p class="col-12">
                        <a asp-area="Admin" asp-controller="User" asp-action="Create" class="btn btn-success text-white">افزودن کاربر جدید</a>
                    </p>
                </div>
            </div>
            <div class="body">
                <h2><i class="fe fe-users "></i> @ViewData["Title"]</h2>
                <div class="table-responsive">
                    <div id="tableExport_wrapper" class="dataTables_wrapper dt-bootstrap4">
                        <table class="table table-borderless dataTable table-responsive w-100 d-block d-table table-hover" role="grid">
                            <thead class="thead-dark">
                                <tr role="row">
                                    <th class="center sorting" tabindex="0" aria-controls="tableExport" rowspan="1" colspan="1" aria-label="نام: activate to sort column ascending" style="width: 70.8875px;">نام </th>
                                    <th class="center sorting" tabindex="0" aria-controls="tableExport" rowspan="1" colspan="1" aria-label="نام خانوادگی: activate to sort column ascending" style="width: 70.8875px;">نام خانوادگی</th>
                                    <th class="center sorting" tabindex="0" aria-controls="tableExport" rowspan="1" colspan="1" aria-label="تاریخ ایجاد: activate to sort column ascending" style="width: 70.8875px;">تاریخ ایجاد</th>
                                    <th class="center sorting" tabindex="0" aria-controls="tableExport" rowspan="1" colspan="1" aria-label="تاریخ تولد: activate to sort column ascending" style="width: 70.8875px;">تاریخ تولد</th>
                                    <th class="center sorting" tabindex="0" aria-controls="tableExport" rowspan="1" colspan="1" aria-label="جنسیت: activate to sort column ascending" style="width: 70.8875px;">جنسیت</th>
                                    <th class="center sorting" tabindex="0" aria-controls="tableExport" rowspan="1" colspan="1" aria-label="شماره تلفن: activate to sort column ascending" style="width: 70.8875px;">شماره تلفن</th>
                                    <th class="center sorting" tabindex="0" aria-controls="tableExport" rowspan="1" colspan="1" aria-label="وضعیت: activate to sort column ascending" style="width: 70.8875px;">وضعیت</th>
                                    <th class="center sorting" tabindex="0" aria-controls="tableExport" rowspan="1" colspan="1" aria-label="موقعیت: activate to sort column ascending" style="width: 70.8875px;">موقعیت</th>
                                    <th class="center sorting" tabindex="0" aria-controls="tableExport" rowspan="1" colspan="1" aria-label="اقدام: activate to sort column ascending" style="width: 70.8875px;">اقدام</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Entities.CheckNullability())
                                {
                                    @foreach (var item in Model.Entities)
                                    {
                                        <tr role="row" class="@((item.Status==UserStatus.Ban)?" bg-warning":"") @((item.IsDeleted==true)?"bg-danger":"") text-dark">
                                            <td class="center">@item.FirstName</td>
                                            <td class="center">@item.LastName</td>
                                            <td class="center">@item.CreatedDate.ToShamsi()</td>
                                            <td class="center">@item.BirthDay?.ToShamsi()</td>
                                            <td class="center">
                                                @if (item.Gender == UserGender.Male)
                                                {
                                                    <span class="badge badge-blue text-white">@UserGender.Male.GetDisplayName()</span>
                                                }
                                                else if (item.Gender == UserGender.Female)
                                                {
                                                    <span class="badge badge-pink text-white">@UserGender.Female.GetDisplayName()</span>
                                                }
                                            </td>
                                            <td class="center">@item.PhoneNumber</td>
                                            <td class="center">
                                                @switch (item.Status)
                                                {
                                                    case UserStatus.Active:
                                                        <span class="badge badge-success text-white">@UserStatus.Active.GetDisplayName()</span>
                                                        break;
                                                    case UserStatus.NotActive:
                                                        <span class="badge badge-primary text-white">@UserStatus.NotActive.GetDisplayName()</span>
                                                        break;
                                                    case UserStatus.Ban:
                                                        <span class="badge badge-danger text-white">@UserStatus.Ban.GetDisplayName()</span>
                                                        break;
                                                }
                                            </td>
                                            <td class="center">
                                                @switch (item.Situation)
                                                {
                                                    case UserSituation.Athlete:
                                                        <span class="badge badge-green text-white">@UserSituation.Athlete.GetDisplayName()</span>
                                                        break;
                                                    case UserSituation.Trainer:
                                                        <span class="badge badge-orange text-white">@UserSituation.Trainer.GetDisplayName()</span>
                                                        break;
                                                    case UserSituation.Cader:
                                                        <span class="badge badge-primary text-white">@UserSituation.Cader.GetDisplayName()</span>
                                                        break;
                                                }
                                            </td>
                                            <td class="center">
                                                <a asp-area="Admin" asp-controller="User" asp-action="Detail" asp-route-id="@item.Id" class="text-secondary">
                                                    <i class="fe fe-24 fe-alert-circle text-info"></i>
                                                </a>
                                                @if (item.IsDeleted == false)
                                                {
                                                    <a asp-area="Admin" asp-controller="User" asp-action="Edit" asp-route-id="@item.Id" class="text-success">
                                                        <i class="fe fe-24 fe-edit-3"></i>
                                                    </a>                                                    
                                                    <a onclick="confirmDelete('@Url.Action("Delete","User",new{id=item.Id})',event,'@item.GetUserName()')" class="text-danger">
                                                        <i class="fe fe-24 fe-trash-2"></i>
                                                    </a>
                                                    <a asp-area="Admin" asp-controller="User" asp-action="ChangePassword" asp-route-id="@item.Id" class="text-lock">
                                                        <i class="fe fe-24 fe-lock"></i>
                                                    </a>
                                                    <a onclick="ShowAddingItemForm('@Url.Action("ChargeWallet","Wallet",new{userId=item.Id})','تراکنش @item.GetUserName()')" class="text-warning">
                                                        <i class="fe fe-24 fe-dollar-sign "></i>
                                                    </a>
                                                    <a asp-area="Admin" asp-controller="Wallet" asp-action="List" asp-route-UserName="@item.GetUserName()" asp-route-UserId="@item.Id" class="text-primary">
                                                        <i class="bx bx-wallet fe-24"></i>
                                                    </a>
                                                }                                                
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            
                <div class="footer">
                    <div class="dataTables_info" id="tableExport_info" role="status" aria-live="polite">نمایش @Model.StartItemFromList تا @Model.EndItemFromList از @Model.AllEntitiesCount ورودی</div>
                @if (Model.PageCount > 1)
                {
                    <partial name="_AdminPaging" model="Model.GetCurrentPaging()" />
                }
                </div>
            
        </div>
    </div>
</div>