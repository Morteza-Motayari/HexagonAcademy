@using Hexagon.Application.Extensions
@using Hexagon.Application.Statics
@using Hexagon.Domain.Enums.Users
@using Hexagon.Domain.ViewModels.Users.Roles
@using Hexagon.Domain.ViewModels.Users.Users
@model CreateUserViewModel
@{
    ViewData["Title"] = "افزودن کاربر جدید";
    int j = 0;
    List<RoleViewModel> roles = ViewData["roles"] as List<RoleViewModel> ?? new List<RoleViewModel>();
}
<div class="row">
    <div class="pl-3">
        <nav style="--bs-breadcrumb-divider: '>';" aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Home" asp-action="Index">خانه</a></li>
                <li class="breadcrumb-item active" aria-current="page"><a asp-area="Admin" asp-controller="User" asp-action="List">کاربران</a></li>
                <li class="breadcrumb-item active" aria-current="page"><a asp-area="Admin" asp-controller="User" asp-action="Create">افزودن کاربر</a></li>
            </ol>
        </nav>
    </div>
    <div class="col-12">
        <div class="card">
            <div class="header">
                <h2 class="mt-3">
                    <i class="fe fe-24 fe-user-plus"></i> @ViewData["Title"]
                </h2>
            </div>
            <div class="body">
                <form method="post" enctype="multipart/form-data" asp-area="Admin" class="row col-md-12" asp-controller="User" asp-action="Create">
                    <div class="col-md-8">
                        <div class="row">
                            <div class="form-group col-md-6">
                                <label asp-for="FirstName" class="form-control-label"></label>
                                <input asp-for="FirstName" class="form-control" />
                                <span asp-validation-for="FirstName" class="text-danger"></span>
                            </div>
                            <div class="form-group col-md-6">
                                <label asp-for="LastName" class="form-control-label"></label>
                                <input asp-for="LastName" class="form-control" />
                                <span asp-validation-for="LastName" class="text-danger"></span>
                            </div><div class="form-group col-md-6">
                                <label asp-for="PhoneNumber" class="form-control-label"></label>
                                <input asp-for="PhoneNumber" class="form-control" />
                                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                            </div>                            
                            <div class="form-group col-md-6">
                                <label asp-for="NationalCode" class="form-control-label"></label>
                                <input asp-for="NationalCode" class="form-control" />
                                <span asp-validation-for="NationalCode" class="text-danger"></span>
                            </div>
                            <div class="form-group col-md-6">
                                <label asp-for="city" class="form-control-label"></label>
                                <input asp-for="city" class="form-control" />
                                <span asp-validation-for="city" class="text-danger"></span>
                            </div>
                            <div class="form-group col-md-6">
                                <label asp-for="BirthDay" class="control-label"></label>
                                <div class="input-group">
                                    <input asp-for="BirthDay" data-jdp type="text" class="form-control" id="birthDay">
                                    <div class="input-group-append">
                                        <div data-jdp class="input-group-text"><span class="fe fe-24 fe-calendar"></span></div>
                                    </div>
                                    <span asp-validation-for="BirthDay" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="form-group col-md-12">
                                <label asp-for="email" class="form-control-label"></label>
                                <input asp-for="email" class="form-control" placeholder="@Convert.ToString("xxxxx@example.com")" />
                                <span asp-validation-for="email" class="text-danger"></span>
                            </div>
                            <div class="form-group col-md-4">
                                <label asp-for="Gender"></label>
                                <div class="custom-radio">
                                    <input asp-for="Gender" type="radio" value="@UserGender.Female" class=" bxs">
                                    <label>
                                        @UserGender.Female.GetDisplayName()
                                    </label>
                                </div>
                                <div class=" custom-radio mb-3">
                                    <input asp-for="Gender" type="radio" value="@UserGender.Male" class="bxs">
                                    <label>
                                        @UserGender.Male.GetDisplayName()
                                    </label>
                                </div>
                                <span asp-validation-for="Gender" class="text-danger"></span>
                            </div>
                            <div class="form-group col-md-4">
                                <label asp-for="Situation" class="control-label"></label>
                                <select asp-for="Situation" class="form-control">
                                    @foreach (var item in Enum.GetValues(typeof(UserSituation)).Cast<UserSituation>().ToList())
                                    {
                                        <option value="@item">@item.GetDisplayName()</option>
                                    }
                                </select>
                            </div>
                            <div class="form-group col-md-4">
                                <label asp-for="Status" class="control-label"></label>
                                <select asp-for="Status" class="form-control">
                                    @foreach (var item in Enum.GetValues(typeof(UserStatus)).Cast<UserStatus>().ToList())
                                    {
                                        <option value="@item">@item.GetDisplayName()</option>
                                    }
                                </select>
                            </div>                            
                            <div class="form-group col-md-6">
                                <label asp-for="Password" class="form-control-label"></label>
                                <input asp-for="Password" class="form-control" />
                                <span asp-validation-for="Password" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="row ">
                            <div class="col-md-3 text-center">
                                <label asp-for="Image" class="control-label"></label>
                                <div class="avatar avatar-xl contact-photo">
                                    <img id="avatar" src=@($"{SavingPath.AvatarPath}default.png") alt="..." class="img-responsive">
                                </div>
                            </div>
                            <div class="col">
                                <div class="custom-file mb-3">
                                    <input asp-for="Image" id="avaterFile" type="file">
                                </div>
                            </div>
                        </div>
                        <br />
                        <h2>نقش ها</h2>
                        <hr />
                        <div>
                            @if (roles.CheckNullability())
                            {
                                @foreach (var item in roles)
                                {
                                    <div class="custom-checkbox">
                                        <input type="checkbox" class="bxs" name="RolesId" value="@item.Id">
                                        <label for="customCheck1">@item.RoleTitle</label>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <input type="submit" value="ایجاد کاربر" class="btn btn-success" />
                            <a asp-area="Admin" asp-controller="User" asp-action="List" class="btn btn-secondary">برگشت به لیست</a>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="~/js/jalalidatepicker.min.js"></script>
    <script>
        jalaliDatepicker.startWatch();
    </script>
    <script>
        avaterFile.onchange = evt => {
            const [file] = avaterFile.files
            if (file) {
                avatar.src = URL.createObjectURL(file)
            }
        }
    </script>
    <script>
        // Function to prevent typing and pasting in the input field
        function disableInput(event) {
            event.preventDefault();
        }

        document.addEventListener("DOMContentLoaded", () => {
            const inputField = document.getElementById("birthDay");

            // Disable typing
            inputField.addEventListener("keydown", disableInput);

            // Disable pasting
            inputField.addEventListener("paste", disableInput);
        });
    </script>
}