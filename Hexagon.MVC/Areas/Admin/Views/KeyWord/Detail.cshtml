@using Hexagon.Application.Convertors
@using Hexagon.Domain.ViewModels.KeyWords
@model AdminSideDetailKeyWordViewModel
@{
    ViewData["Title"] = "جزئیات کلمه کلیدی";
}
<div class="row">
    <div class="pl-3">
        <nav style="--bs-breadcrumb-divider: '>';" aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Home" asp-action="Index">خانه</a></li>
                <li class="breadcrumb-item active" aria-current="page"><a asp-area="Admin" asp-controller="SportClass" asp-action="List">کلاس های ورزشی</a></li>
                <li class="breadcrumb-item active" aria-current="page"><a asp-area="Admin" asp-controller="KeyWord" asp-action="List" asp-route-sportClassId="@Model.SportClassId">کلمات کلیدی</a></li>
                <li class="breadcrumb-item active" aria-current="page"><a asp-area="Admin" asp-controller="KeyWord" asp-action="Detail" asp-route-id="@Model.Id">جزئیات کلمه کلیدی</a></li>
            </ol>
        </nav>
    </div>
    <div class="col-12">
        <div class="card">
            <div class="header">
                <h2 class="mt-3">
                    <i class="bx bx-ball text-dark bxl"></i> @ViewData["Title"]
                </h2>
            </div>
            <div class="body">
                <div class="row col-md-12">                    
                    <div class="col-md-12">
                        <div class="row">
                            @if (Model.IsDeleted == true)
                            {
                                <div class="form-group col-md-12 ">
                                    <p class="h2 mb-3 text-danger">این کلمه کلیدی حذف شده است</p>
                                </div>
                            }
                            <div class="form-group col-md-6">
                                <label asp-for="Key" class="form-control-label"></label>
                                <input asp-for="Key" class="form-control" disabled="" />
                            </div>
                            <div class="form-group col-md-6">
                                <label asp-for="SportClass" class="form-control-label"></label>
                                <a class="form-control color-disabled" asp-area="Admin" asp-controller="SportClass" asp-action="Detail" asp-route-id="@Model.SportClassId">@Model.SportClass</a>
                            </div>
                            <div class="form-group col-md-6">
                                <label asp-for="CreatedDate" class="control-label"></label>
                                <input value="@Model.CreatedDate.ToShamsiWithHour()" type="text" class="form-control" id="birthDay" disabled="">
                            </div>
                            <div class="form-group col-md-6">
                                <label asp-for="LastModifiedDate" class="control-label"></label>
                                <input value="@Model.LastModifiedDate?.ToShamsiWithHour()" type="text" class="form-control" id="birthDay" disabled="">
                            </div>
                            <div class="form-group col-md-6">
                                <label asp-for="CreatedBy" class="form-control-label"></label>
                                <a asp-area="Admin" asp-controller="User" asp-action="Detail" asp-route-id="@Model.CreatedById">@Model.CreatedBy</a>
                            </div>
                            <div class="form-group col-md-6">
                                <label asp-for="LastModifiedBy" class="form-control-label"></label>
                                <a asp-area="Admin" asp-controller="User" asp-action="Detail" asp-route-id="@Model.LastModifiedById">@Model.LastModifiedBy</a>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            @if (Model.IsDeleted == false)
                            {
                                <a onclick="ShowAddingItemForm('@Url.Action("Edit","KeyWord",new{id=Model.Id})','ویرایش کلمه کلیدی')" class="btn btn-primary">ویرایش کلمه کلیدی</a>
                            }
                            <a asp-area="Admin" asp-controller="KeyWord" asp-action="List" asp-route-sportClassId="@Model.SportClassId" class="btn btn-secondary">برگشت به لیست</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
