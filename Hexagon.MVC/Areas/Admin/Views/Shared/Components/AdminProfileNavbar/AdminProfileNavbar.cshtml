@using Hexagon.Application.Statics
@using Hexagon.Domain.ViewModels.Users.Users
@using Hexagon.Application.Extensions
@model UserClientSideView
<li class="nav-item dropdown">
    <a class="nav-link dropdown-toggle text-muted pr-0" href="#" id="navbarDropdownMenuLink" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
        <span class="avatar avatar-sm mt-2">
            <img src="@SavingPath.AvatarPath@((!string.IsNullOrEmpty(Model.Avatar))?$"{Model.Avatar}":"default.png")" alt="@Model.GetUserName()" class="avatar-img rounded-circle">
        </span>
    </a>
    <div class="dropdown-menu dropdown-menu-right" aria-labelledby="navbarDropdownMenuLink">
        <a class="dropdown-item" asp-area="Admin" asp-controller="User" asp-action="Edit" asp-route-id="@Model.Id">ویرایش اطلاعات</a>
        <a class="dropdown-item" asp-area="" asp-controller="Account" asp-action="LogOut">خروج از حساب</a>        
    </div>
</li>