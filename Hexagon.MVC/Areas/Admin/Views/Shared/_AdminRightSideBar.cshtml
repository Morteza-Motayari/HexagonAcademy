@using Hexagon.Application.Extensions
@using Hexagon.Application.Services.Interfaces.Users
@inject IUserService userService
@{
    int userId = User.GetUserId();
}
<aside class="sidebar-left border-right bg-white shadow" id="leftSidebar" data-simplebar>
    <a href="#" class="btn collapseSidebar toggle-btn d-lg-none text-muted ml-2 mt-3" data-toggle="toggle">
        <i class="fe fe-x"><span class="sr-only"></span></i>
    </a>
    <nav class="vertnav navbar navbar-light">
        <!-- nav bar -->
        <div class="w-100 mb-4 d-flex">
            <a class="navbar-brand mx-auto mt-2 flex-fill text-center" asp-area="Admin" asp-controller="Home" asp-action="Index">
                @* <svg version="1.1" id="logo" class="navbar-brand-img brand-sm" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" x="0px" y="0px" viewBox="0 0 120 120" xml:space="preserve">
                <g>
                <polygon class="st0" points="78,105 15,105 24,87 87,87 	" />
                <polygon class="st0" points="96,69 33,69 42,51 105,51 	" />
                <polygon class="st0" points="78,33 15,33 24,15 87,15 	" />
                </g>
              </svg> *@
                <img src="/img/logo/logo.jpg" class="navbar-brand-img brand-sm" />
            </a>
        </div>
        <ul class="navbar-nav flex-fill w-100 mb-2">
            <li class="nav-item dropdown">
                <a href="#dashboard" data-toggle="collapse" aria-expanded="false" class="dropdown-toggle nav-link">
                    <i class="fe fe-home fe-20"></i>
                    <span class="ml-3 item-text">داشبورد</span><span class="sr-only">(current)</span>
                </a>
                <ul class="collapse list-unstyled pl-4 w-100" id="dashboard">
                    <li class="nav-item active">
                        <a class="nav-link pl-3" asp-area="" asp-controller="Home" asp-action="Index"><span class="ml-1 item-text">صفحه اصلی سایت</span></a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link pl-3" href="./dashboard-analytics.html"><span class="ml-1 item-text">Analytics</span></a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link pl-3" href="./dashboard-sales.html"><span class="ml-1 item-text">E-commerce</span></a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link pl-3" href="./dashboard-saas.html"><span class="ml-1 item-text">Saas Dashboard</span></a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link pl-3" href="./dashboard-system.html"><span class="ml-1 item-text">Systems</span></a>
                    </li>
                </ul>
            </li>
        </ul>
        <p class="text-muted nav-heading mb-1">
            <span>مدیریت دسترسی ها و کاربران</span>
        </p>
        <ul class="navbar-nav flex-fill w-100 mb-2">
            <li class="nav-item dropdown">
                <a href="#ui-roles" data-toggle="collapse" aria-expanded="false" class="dropdown-toggle nav-link">
                    <i class="fe fe-lock fe-20"></i>
                    <span class="ml-3 item-text">نقش ها</span>
                </a>
                <ul class="collapse list-unstyled pl-4 w-100" id="ui-roles">
                    @if (await userService.CaderHasPermissionAsync(userId, "ManageRoles"))
                    {
                        <li class="nav-item">
                            <a class="nav-link pl-3" asp-area="Admin" asp-controller="Role" asp-action="List">
                                <span class="ml-1 item-text">مدیریت نقش ها</span>
                            </a>
                        </li>
                    }
                    @if (await userService.CaderHasPermissionAsync(userId, "AddRole"))
                    {
                        <li class="nav-item">
                            <a class="nav-link pl-3" asp-area="Admin" asp-controller="Role" asp-action="Create">
                                <span class="ml-1 item-text">افزودن نقش</span>
                            </a>
                        </li>
                    }                   
                </ul>
            </li>
            <li class="nav-item dropdown">
                <a href="#users" data-toggle="collapse" aria-expanded="false" class="dropdown-toggle nav-link">
                    <i class="fe fe-users fe-20"></i>
                    <span class="ml-3 item-text">کاربران</span>
                </a>
                <ul class="collapse list-unstyled pl-4 w-100" id="users">
                    @if (await userService.CaderHasPermissionAsync(userId, "ManageUsers"))
                    {
                        <li class="nav-item">
                            <a class="nav-link pl-3" asp-area="Admin" asp-controller="User" asp-action="List">
                                <span class="ml-1 item-text">لیست کاربران</span>
                            </a>
                        </li>
                    }
                    @if (await userService.CaderHasPermissionAsync(userId, "AddUser"))
                    {
                        <li class="nav-item">
                            <a class="nav-link pl-3" asp-area="Admin" asp-controller="User" asp-action="Create">
                                <span class="ml-1 item-text">افزودن کاربر</span>
                            </a>
                        </li>
                    }
                    @if (await userService.CaderHasPermissionAsync(userId, "ManageTrainers"))
                    {
                        <li class="nav-item">
                            <a class="nav-link pl-3" asp-area="Admin" asp-controller="Trainer" asp-action="List">
                                <span class="ml-1 item-text">لیست مربی ها</span>
                            </a>
                        </li>
                    }
                    @if (await userService.CaderHasPermissionAsync(userId, "AddTrainer"))
                    {
                        <li class="nav-item">
                            <a class="nav-link pl-3" asp-area="Admin" asp-controller="Trainer" asp-action="Create">
                                <span class="ml-1 item-text">افزودن مربی </span>
                            </a>
                        </li>
                    }
                    @if (await userService.CaderHasPermissionAsync(userId, "ManageCaders"))
                    {
                        <li class="nav-item">
                            <a class="nav-link pl-3" asp-area="Admin" asp-controller="Cader" asp-action="List">
                                <span class="ml-1 item-text">لیست کادر ها</span>
                            </a>
                        </li>
                    }
                    @if (await userService.CaderHasPermissionAsync(userId, "AddCader"))
                    {
                        <li class="nav-item">
                            <a class="nav-link pl-3" asp-area="Admin" asp-controller="Cader" asp-action="Create">
                                <span class="ml-1 item-text">افزودن کادر </span>
                            </a>
                        </li>
                    }                    
                </ul>
            </li>
        </ul>
        <p class="text-muted nav-heading mb-1">
            <span>مدیریت باشگاه ها و کلاس ها</span>
        </p>
        <ul class="navbar-nav flex-fill w-100 mb-2">
            <li class="nav-item dropdown">
                <a href="#ui-gyms" data-toggle="collapse" aria-expanded="false" class="dropdown-toggle nav-link">
                    <i class="bx bx-dumbbell text-dark bxs"></i>
                    <span class="ml-3 item-text">باشگاه ها</span>
                </a>
                <ul class="collapse list-unstyled pl-4 w-100" id="ui-gyms">
                    @if (await userService.CaderHasPermissionAsync(userId, "ManageGyms"))
                    {
                        <li class="nav-item">
                            <a class="nav-link pl-3" asp-area="Admin" asp-controller="Gym" asp-action="List">
                                <span class="ml-1 item-text">مدیریت باشگاه ها</span>
                            </a>
                        </li>
                    }
                    @if (await userService.CaderHasPermissionAsync(userId, "AddGym"))
                    {
                        <li class="nav-item">
                            <a class="nav-link pl-3" asp-area="Admin" asp-controller="Gym" asp-action="Create">
                                <span class="ml-1 item-text">افزودن باشگاه</span>
                            </a>
                        </li>
                    }                    
                </ul>
            </li>
            <li class="nav-item dropdown">
                <a href="#classes" data-toggle="collapse" aria-expanded="false" class="dropdown-toggle nav-link">
                    <i class="bx bxs-category text-dark bxs fe-20"></i>
                    <span class="ml-3 item-text">کلاس ها</span>
                </a>
                <ul class="collapse list-unstyled pl-4 w-100" id="classes">
                    @if (await userService.CaderHasPermissionAsync(userId, "ManageSportClasses"))
                    {
                        <li class="nav-item">
                            <a class="nav-link pl-3" asp-area="Admin" asp-controller="SportClass" asp-action="List">
                                <span class="ml-1 item-text">لیست کلاس ها</span>
                            </a>
                        </li>
                    }
                    @if (await userService.CaderHasPermissionAsync(userId, "AddSportClass"))
                    {
                        <li class="nav-item">
                            <a class="nav-link pl-3" asp-area="Admin" asp-controller="SportClass" asp-action="Create">
                                <span class="ml-1 item-text">افزودن کلاس</span>
                            </a>
                        </li>
                    }                   
                </ul>
            </li>
            <li class="nav-item dropdown">
                <a href="#trainers" data-toggle="collapse" aria-expanded="false" class="dropdown-toggle nav-link">
                    <i class="bx bx-ball bxs fe-20"></i>
                    <span class="ml-3 item-text">رشته های ورزشی</span>
                </a>
                <ul class="collapse list-unstyled pl-4 w-100" id="trainers">
                    @if (await userService.CaderHasPermissionAsync(userId, "ManageSports"))
                    {
                        <li class="nav-item">
                            <a class="nav-link pl-3" asp-area="Admin" asp-controller="Sport" asp-action="List">
                                <span class="ml-1 item-text">لیست رشته های ورزشی</span>
                            </a>
                        </li>
                    }
                    @if (await userService.CaderHasPermissionAsync(userId, "AddSport"))
                    {
                        <li class="nav-item">
                            <a class="nav-link pl-3" onclick="ShowAddingItemForm('@Url.Action("Create","Sport")',' افزودن رشته ورزشی جدید ')">
                                <span class="ml-1 item-text">افزودن رشته ورزشی</span>
                            </a>
                        </li>
                    }
                    
                </ul>
            </li>
            @if (await userService.CaderHasPermissionAsync(userId, "ManageBanners"))
            {
                <li class="nav-item">
                    <a class="nav-link pl-3" asp-area="Admin" asp-controller="Banner" asp-action="Banner">
                        <i class="bx bx-images fe-20 text-dark bxs"></i>
                        <span class="ml-1 item-text">مدیریت بنرها</span>
                    </a>
                </li>
            }
            
        </ul>
        <p class="text-muted nav-heading mb-1">
            <span>مدیریت مدارک و سوابق</span>
        </p>
        <ul class="navbar-nav flex-fill w-100 mb-2">
            <li class="nav-item dropdown">
                <a href="#ui-certificates" data-toggle="collapse" aria-expanded="false" class="dropdown-toggle nav-link">
                    <i class="fe fe-file-text fe-20 text-dark bxs"></i>
                    <span class="ml-3 item-text">مدرک ها</span>
                </a>
                <ul class="collapse list-unstyled pl-4 w-100" id="ui-certificates">
                    @if (await userService.CaderHasPermissionAsync(userId, "ManageCertificates"))
                    {
                        <li class="nav-item">
                            <a class="nav-link pl-3" asp-area="Admin" asp-controller="Certificate" asp-action="List">
                                <span class="ml-1 item-text">مدیریت مدرک ها</span>
                            </a>
                        </li>
                    }
                    @if (await userService.CaderHasPermissionAsync(userId, "AddCertificate"))
                    {
                        <li class="nav-item">
                            <a class="nav-link pl-3" asp-area="Admin" asp-controller="Certificate" asp-action="Create">
                                <span class="ml-1 item-text">افزودن مدرک</span>
                            </a>
                        </li>
                    }
                    
                </ul>
            </li>
            @if (await userService.CaderHasPermissionAsync(userId, "ManageExperiences"))
            {
                <li class="nav-item">
                    <a class="nav-link pl-3" asp-area="Admin" asp-controller="Experience" asp-action="List">
                        <i class="fe fe-award fe-20 text-dark bxs"></i>
                        <span class="ml-1 item-text">سابقه ها</span>
                    </a>
                </li>
            }            
        </ul>

        <p class="text-muted nav-heading mb-1">
            <span>مدیریت فاکتورها ها و تراکنش ها</span>
        </p>
        <ul class="navbar-nav flex-fill w-100 mb-2">
            @if (await userService.CaderHasPermissionAsync(userId, "ManageWallets"))
            {
                <li class="nav-item">
                    <a class="nav-link pl-3" asp-area="Admin" asp-controller="Wallet" asp-action="List">
                        <i class="bx bx-wallet fe-20 text-dark bxs"></i>
                        <span class="ml-1 item-text">مدیریت تراکنش ها</span>
                    </a>
                </li>
            }
            @if (await userService.CaderHasPermissionAsync(userId, "ManageOrders"))
            {
                <li class="nav-item">
                    <a class="nav-link pl-3" asp-area="Admin" asp-controller="Order" asp-action="List">
                        <i class="bx bxs-shopping-bags fe-20 text-dark bxs"></i>
                        <span class="ml-1 item-text">مدیریت فاکتور ها</span>
                    </a>
                </li>
            }                       
        </ul>
        <p class="text-muted nav-heading mb-1">
            <span>مدیریت پیام ها و نظرات</span>
        </p>
        <ul class="navbar-nav flex-fill w-100 mb-2">
            <li class="nav-item dropdown">
                <a href="#ui-messages" data-toggle="collapse" aria-expanded="false" class="dropdown-toggle nav-link">
                    <i class="fe fe-message-square fe-20 text-dark bxs"></i>
                    <span class="ml-3 item-text">پیام ها</span>
                </a>                
                <ul class="collapse list-unstyled pl-4 w-100" id="ui-messages">
                    @if (await userService.CaderHasPermissionAsync(userId, "ManageClassComments"))
                    {
                        <li class="nav-item">
                            <a class="nav-link pl-3" asp-area="Admin" asp-controller="ClassComment" asp-action="List">
                                <span class="ml-1 item-text">مدیریت نظرات</span>
                            </a>
                        </li>
                    }
                    @if (await userService.CaderHasPermissionAsync(userId, "ManageContactUses"))
                    {
                        <li class="nav-item">
                            <a class="nav-link pl-3" asp-area="Admin" asp-controller="ContactUs" asp-action="List">
                                <span class="ml-1 item-text">پیام های تماس با ما</span>
                            </a>
                        </li>
                    }
                   
                </ul>
            </li>
            @if (await userService.CaderHasPermissionAsync(userId, "ManageTickets"))
            {
                <li class="nav-item">
                    <a class="nav-link pl-3" asp-area="Admin" asp-controller="Ticket" asp-action="List">
                        <i class="bx bx-conversation fe-20 text-dark bxs"></i>
                        <span class="ml-1 item-text">مدیریت تیکت ها</span>
                    </a>
                </li>
            }            
        </ul>
        <div class="btn-box w-100 mt-4 mb-1">
            <a href="https://themeforest.net/item/tinydash-bootstrap-html-admin-dashboard-template/27511269" target="_blank" class="btn mb-2 btn-primary btn-lg btn-block">
                <i class="fe fe-shopping-cart fe-12 mr-2"></i><span class="small">Buy now</span>
            </a>
        </div>
    </nav>
</aside>