@using Hexagon.Application.Convertors
@using Hexagon.Application.Extensions
@using Hexagon.Domain.Enums.Tickets
@using Hexagon.Domain.ViewModels.Tickets.Tickets
@model FilterTicketViewModel
@{
    ViewData["Title"] = "لیست تیکت ها";
}
<div class="row">
    <div class="pl-3">
        <nav style="--bs-breadcrumb-divider: '>';" aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Home" asp-action="Index">خانه</a></li>
                <li class="breadcrumb-item active" aria-current="page"><a asp-area="Admin" asp-controller="Ticket" asp-action="List">تیکت ها</a></li>
            </ol>
        </nav>
    </div>
    <div class="col-12">
        <div class="card">
            <div class="header">
                <h2><i class="fe fe-24 fe-zoom-in"></i> فیلترها</h2>
                <div class="toolbar">
                    <div class="col-12">
                        <form class="form" method="post" id="filter-search" asp-area="Admin" asp-controller="Ticket" asp-action="List">
                            <input type="hidden" asp-for="Page" />
                            <div class="form-row row pl-4">
                                <div class="col-12 col-sm-6 col-md-4">
                                    <div class="form-group">
                                        <label asp-for="Title" class="control-label"></label>
                                        <input asp-for="Title" class="form-control ">
                                    </div>
                                </div>
                                <div class="col-12 col-sm-6 col-md-4">
                                    <div class="form-group">
                                        <label asp-for="CreatorName" class="control-label"></label>
                                        <input asp-for="CreatorName" class="form-control ">
                                    </div>
                                </div>
                                <div class="col-12 col-sm-6 col-md-4">
                                    <div class="form-group">
                                        <label asp-for="Status" class="control-label"></label>
                                        <select asp-for="Status" class="form-control">
                                            @foreach (var item in Enum.GetValues(typeof(FilterTicketStatus)).Cast<FilterTicketStatus>().ToList())
                                            {
                                                @if (Model.Status == item)
                                                {
                                                    <option selected value="@item">@item.GetDisplayName()</option>
                                                }
                                                else
                                                {
                                                    <option value="@item">@item.GetDisplayName()</option>
                                                }
                                            }
                                        </select>
                                    </div>
                                </div>
                                <div class="col-12 col-sm-6 col-md-4">
                                    <div class="form-group">
                                        <label asp-for="Section" class="control-label"></label>
                                        <select asp-for="Section" class="form-control">
                                            @foreach (var item in Enum.GetValues(typeof(FilterTicketSection)).Cast<FilterTicketSection>().ToList())
                                            {
                                                @if (Model.Section == item)
                                                {
                                                    <option selected value="@item">@item.GetDisplayName()</option>
                                                }
                                                else
                                                {
                                                    <option value="@item">@item.GetDisplayName()</option>
                                                }
                                            }
                                        </select>
                                    </div>
                                </div>
                                <div class="col-12 col-sm-6 col-md-4">
                                    <div class="form-group">
                                        <label asp-for="Priority" class="control-label"></label>
                                        <select asp-for="Priority" class="form-control">
                                            @foreach (var item in Enum.GetValues(typeof(FilterTicketPriority)).Cast<FilterTicketPriority>().ToList())
                                            {
                                                @if (Model.Priority == item)
                                                {
                                                    <option selected value="@item">@item.GetDisplayName()</option>
                                                }
                                                else
                                                {
                                                    <option value="@item">@item.GetDisplayName()</option>
                                                }
                                            }
                                        </select>
                                    </div>
                                </div>
                                <div class="col-12 col-sm-6 col-md-4 py-2">
                                    <label class="control-label">
                                        نمایش ورودی
                                        <select asp-for="TakeEntity" aria-controls="DataTables_Table_0" class="custom-select custom-select-sm form-control form-control-sm">
                                            <option value="3">3</option>
                                            <option value="5">5</option>
                                            <option value="10">10</option>
                                            <option value="25">15</option>
                                        </select>
                                    </label>
                                </div>
                                <div class="col-12 col-sm-12 ">
                                    <input type="submit" value="جستجو" class="btn btn-outline-success" />
                                </div>
                            </div>
                        </form>
                    </div>
                    <br />
                </div>
            </div>
            <div class="body">
                <h2><i class="bx bx-conversation text-dark bxl"></i> @ViewData["Title"]</h2>
                <div class="table-responsive">
                    <div id="tableExport_wrapper" class="dataTables_wrapper dt-bootstrap4">
                        <table class="table table-borderless dataTable table-responsive w-100 d-block d-table table-hover" role="grid">
                            <thead class="thead-dark">
                                <tr role="row">
                                    <th class="center sorting" tabindex="0" aria-controls="tableExport" rowspan="1" colspan="1" aria-label="سازنده: activate to sort column ascending">سازنده</th>
                                    <th class="center sorting" tabindex="0" aria-controls="tableExport" rowspan="1" colspan="1" aria-label="موضوع: activate to sort column ascending">موضوع</th>
                                    <th class="center sorting" tabindex="0" aria-controls="tableExport" rowspan="1" colspan="1" aria-label="وضعیت: activate to sort column ascending">وضعیت</th>
                                    <th class="center sorting" tabindex="0" aria-controls="tableExport" rowspan="1" colspan="1" aria-label="بخش: activate to sort column ascending">بخش</th>
                                    <th class="center sorting" tabindex="0" aria-controls="tableExport" rowspan="1" colspan="1" aria-label="اهمیت: activate to sort column ascending">اهمیت</th>
                                    <th class="center sorting" tabindex="0" aria-controls="tableExport" rowspan="1" colspan="1" aria-label="تاریخ ایجاد: activate to sort column ascending">تاریخ ایجاد</th>
                                    <th class="center sorting" tabindex="0" aria-controls="tableExport" rowspan="1" colspan="1" aria-label="اقدام: activate to sort column ascending">اقدام</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Entities.CheckNullability())
                                {
                                    @foreach (var item in Model.Entities)
                                    {
                                        <tr role="row" class="@((item.IsDeleted==true)?"bg-danger":"") text-dark">
                                            <td class="center"><a asp-area="Admin" asp-controller="User" asp-action="Detail" asp-route-id="@item.CreatorId">@item.CreatorName</a></td>
                                            <td class="center">@item.Title</td>
                                            <td class="center">
                                                @switch (item.Status)
                                                {
                                                    case TicketStatus.Pending:
                                                        <span class="badge badge-warning text-white">@item.Status.GetDisplayName()</span>
                                                        break;
                                                    case TicketStatus.AdminAnswered:
                                                        <span class="badge badge-success text-white">@item.Status.GetDisplayName()</span>
                                                        break;
                                                    case TicketStatus.UserAnswered:
                                                        <span class="badge badge-primary text-white">@item.Status.GetDisplayName()</span>
                                                        break;
                                                    case TicketStatus.Close:
                                                        <span class="badge badge-info text-white">@item.Status.GetDisplayName()</span>
                                                        break;
                                                }
                                            </td>
                                            <td class="center">
                                                @switch (item.Section)
                                                {
                                                    case TicketSection.Financial:
                                                        <span class="badge badge-warning text-white">@item.Section.GetDisplayName()</span>
                                                        break;
                                                    case TicketSection.Technical:
                                                        <span class="badge badge-success text-white">@item.Section.GetDisplayName()</span>
                                                        break;
                                                    case TicketSection.HR:
                                                        <span class="badge badge-primary text-white">@item.Section.GetDisplayName()</span>
                                                        break;
                                                }
                                            </td>
                                            <td class="center">
                                                @switch (item.Priority)
                                                {
                                                    case TicketPriority.Important:
                                                        <span class="badge badge-danger text-white">@item.Priority.GetDisplayName()</span>
                                                        break;
                                                    case TicketPriority.Medium:
                                                        <span class="badge badge-warning text-white">@item.Priority.GetDisplayName()</span>
                                                        break;
                                                    case TicketPriority.Low:
                                                        <span class="badge badge-info text-white">@item.Priority.GetDisplayName()</span>
                                                        break;
                                                }
                                            </td>
                                            <td class="center">@item.CreatedDate.ToShamsi()</td>
                                            <td class="center">
                                                @if (item.IsDeleted == false)
                                                {
                                                    <a onclick="confirmDelete('@Url.Action("DeleteTicket","Ticket",new{id=item.Id})',event,'تیکت @item.Title')" class="text-danger">
                                                        <i class="fe fe-24 fe-trash-2"></i>
                                                    </a>
                                                    <a onclick="ShowAddingItemForm('@Url.Action("ChangeStatus","Ticket",new{id=item.Id})','تغییر وضعیت تیکت')" class="text-primary">
                                                        <i class="fe fe-24 fe-edit"></i>
                                                    </a>
                                                }
                                                else
                                                {
                                                    <a onclick="confirmDeleteForever('@Url.Action("DeleteForeverTicket","Ticket",new{id=item.Id})',event,'تیکت @item.Title')" class="text-warning">
                                                        <i class="fe fe-24 fe-trash"></i>
                                                    </a>
                                                }
                                                <a asp-area="Admin" asp-controller="Ticket" asp-action="Detail" asp-route-id="@item.Id" class="text-secondary">
                                                    <i class="fe fe-pen-tool text-info fe-24"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="footer">
                <div class="dataTables_info" id="tableExport_info" role="status" aria-live="polite">نمایش @Model.StartItemFromList تا @Model.EndItemFromList از @Model.AllEntitiesCount ورودی</div>
                @if (Model.PageCount > 1)
                {
                    <partial name="_AdminPaging" model="Model.GetCurrentPaging()" />
                }
            </div>

        </div>
    </div>
</div>