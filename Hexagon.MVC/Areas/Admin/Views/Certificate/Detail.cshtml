@using Hexagon.Application.Convertors
@using Hexagon.Domain.ViewModels.Records.Certificates
@model AdminSideDetailCertificateViewModel
@{
    ViewData["Title"] = "جزئیات مدرک";
}
<div class="row">
    <div class="pl-3">
        <nav style="--bs-breadcrumb-divider: '>';" aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Home" asp-action="Index">خانه</a></li>
                <li class="breadcrumb-item active" aria-current="page"><a asp-area="Admin" asp-controller="Certificate" asp-action="List">مدرک ها</a></li>
                <li class="breadcrumb-item active" aria-current="page"><a asp-area="Admin" asp-controller="Certificate" asp-action="Detail" asp-route-id="@Model.Id">جزئیات مدرک</a></li>
            </ol>
        </nav>
    </div>
    <div class="col-12">
        <div class="card">
            <div class="header">
                <h2 class="mt-3">
                    <i class="fe fe-file-text text-dark bxl"></i> @ViewData["Title"]
                </h2>
            </div>
            <div class="body">
                <div class="row col-md-12">                    
                    <div class="col-md-12">
                        <div class="row">
                            @if (Model.IsDeleted == true)
                            {
                                <div class="form-group col-md-12 ">
                                        <p class="h2 mb-3 text-danger">این مدرک حذف شده است</p> 
                                </div>
                            }
                            <div class="form-group col-md-6">
                                <label asp-for="Name" class="form-control-label"></label>
                                <input asp-for="Name" class="form-control" disabled="" />
                            </div>
                            <div class="form-group col-md-12">
                                <label asp-for="Details" class="form-control-label"></label>
                                <textarea asp-for="Details" class="form-control" disabled=""></textarea>
                            </div>
                            <div class="form-group col-md-6">
                                <label asp-for="CreatedDate" class="control-label"></label>
                                <input value="@Model.CreatedDate.ToShamsiWithHour()" type="text" class="form-control" id="birthDay" disabled="">
                            </div>
                            <div class="form-group col-md-6">
                                <label asp-for="LastModifiedDate" class="control-label"></label>
                                <input value="@Model.LastModifiedDate?.ToShamsiWithHour()" type="text" class="form-control" id="birthDay" disabled="">
                            </div>
                            <div class="form-group col-md-6">
                                <label asp-for="CreatedBy" class="form-control-label"></label>
                                <a asp-area="Admin" asp-controller="User" asp-action="Detail" asp-route-id="@Model.CreatedById">@Model.CreatedBy</a>
                            </div>
                            <div class="form-group col-md-6">
                                <label asp-for="LastModifiedBy" class="form-control-label"></label>
                                <a asp-area="Admin" asp-controller="User" asp-action="Detail" asp-route-id="@Model.LastModifiedById">@Model.LastModifiedBy</a>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            @if (Model.IsDeleted == false)
                            {
                                <a asp-area="Admin" asp-controller="Certificate" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">ویرایش مدرک</a>
                            }
                            <a asp-area="Admin" asp-controller="Certificate" asp-action="List" class="btn btn-secondary">برگشت به لیست</a>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>
