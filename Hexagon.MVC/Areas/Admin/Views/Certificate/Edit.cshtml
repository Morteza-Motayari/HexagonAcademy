@using Hexagon.Domain.ViewModels.Records.Certificates
@model UpdateCertificateViewModel
@{
    ViewData["Title"] = "ویرایش مدرک";
}
<div class="row">
    <div class="pl-3">
        <nav style="--bs-breadcrumb-divider: '>';" aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Home" asp-action="Index">خانه</a></li>
                <li class="breadcrumb-item active" aria-current="page"><a asp-area="Admin" asp-controller="Certificate" asp-action="List">مدرک ها</a></li>
                <li class="breadcrumb-item active" aria-current="page"><a asp-area="Admin" asp-controller="Certificate" asp-action="Edit" asp-route-id="@Model.Id">ویرایش مدرک</a></li>
            </ol>
        </nav>
    </div>
    <div class="col-12">
        <div class="card">
            <div class="header">
                <h2 class="mt-3">
                    <i class="fe fe-file-text text-dark bxl"></i> @ViewData["Title"]
                </h2>
            </div>
            <div class="body">
                <form method="post" asp-area="Admin" class="row col-md-12" asp-controller="Certificate" asp-action="Edit">
                    <input asp-for="Id" type="hidden" />
                    <div class="col-md-12">
                        <div class="row">
                            <div class="form-group col-md-6">
                                <label asp-for="Name" class="form-control-label"></label>
                                <input asp-for="Name" class="form-control" />
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>
                            <div class="form-group col-md-12">
                                <label asp-for="Details" class="form-control-label"></label>
                                <textarea asp-for="Details" class="form-control"></textarea>
                                <span asp-validation-for="Details" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <input type="submit" value="ویرایش مدرک" class="btn btn-primary" />
                            <a asp-area="Admin" asp-controller="Certificate" asp-action="List" class="btn btn-secondary">برگشت به لیست</a>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>