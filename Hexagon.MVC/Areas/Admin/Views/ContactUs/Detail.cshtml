@using Hexagon.Application.Convertors
@using Hexagon.Domain.ViewModels.Contact_Us
@model AdminSideDetailContactUsViewModel
@{
    ViewData["Title"] = "جزئیات درخواست";
}
<div class="row">
    <div class="pl-3">
        <nav style="--bs-breadcrumb-divider: '>';" aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Home" asp-action="Index">خانه</a></li>
                <li class="breadcrumb-item active" aria-current="page"><a asp-area="Admin" asp-controller="ContactUs" asp-action="List">درخواست ها</a></li>
                <li class="breadcrumb-item active" aria-current="page"><a asp-area="Admin" asp-controller="ContactUs" asp-action="Detail" asp-route-id="@Model.Id">جزئیات درخواست</a></li>
            </ol>
        </nav>
    </div>
    <div class="col-12">
        <div class="card">
            <div class="header">
                <h2 class="mt-3">
                    <i class="fe fe-monitor fe-24"></i> @ViewData["Title"]
                </h2>
            </div>
            <div class="body">
                <div class="row col-md-12">
                    <div class="col-md-12">
                        <div class="row">
                            @if (Model.IsDeleted == true)
                            {
                                <div class="form-group col-md-12 ">
                                    <p class="h2 mb-3 text-danger">این درخواست حذف شده است</p>
                                </div>
                            }
                            @if (Model.IsAnswered == true)
                            {
                                <div class="form-group col-md-12 ">
                                    <p class="h2 mb-3 text-success">این درخواست پاسخ داده شده است</p>
                                </div>
                            }
                            <div class="form-group col-md-6">
                                <label asp-for="Subject" class="form-control-label"></label>
                                <input asp-for="Subject" class="form-control" disabled="" />
                            </div>
                            <div class="form-group col-md-6">
                                <label asp-for="FullName" class="form-control-label"></label>
                                <input asp-for="FullName" class="form-control" disabled="" />
                            </div>
                            <div class="form-group col-md-6">
                                <label asp-for="Email" class="form-control-label"></label>
                                <input asp-for="Email" class="form-control" disabled="" />
                            </div>
                            <div class="form-group col-md-6">
                                <label asp-for="Phone" class="form-control-label"></label>
                                <input asp-for="Phone" class="form-control" disabled="" />
                            </div>
                            <div class="form-group col-md-12">
                                <label asp-for="Description" class="form-control-label"></label>
                                <textarea asp-for="Description" class="form-control" disabled="">@Model.Description</textarea>
                            </div>
                            <div class="form-group col-md-12">
                                <label asp-for="Answer" class="form-control-label"></label>
                                <textarea asp-for="Answer" class="form-control" disabled="">@Model.Answer</textarea>
                            </div>
                            <div class="form-group col-md-10">
                                <label asp-for="IP" class="form-control-label"></label>
                                <input asp-for="IP" class="form-control" disabled="" />
                            </div>
                            <div class="form-group col-md-6">
                                <label asp-for="CreatedDate" class="control-label"></label>
                                <input value="@Model.CreatedDate.ToShamsiWithHour()" type="text" class="form-control" id="birthDay" disabled="">
                            </div>
                            <div class="form-group col-md-6">
                                <label asp-for="LastModifiedDate" class="control-label"></label>
                                <input value="@Model.LastModifiedDate?.ToShamsiWithHour()" type="text" class="form-control" id="birthDay" disabled="">
                            </div>
                            <div class="form-group col-md-6">
                                <label asp-for="CreatedBy" class="form-control-label"></label>
                                <a asp-area="Admin" asp-controller="User" asp-action="Detail" asp-route-id="@Model.CreatedById">@Model.CreatedBy</a>
                            </div>
                            <div class="form-group col-md-6">
                                <label asp-for="LastModifiedBy" class="form-control-label"></label>
                                <a asp-area="Admin" asp-controller="User" asp-action="Detail" asp-route-id="@Model.LastModifiedById">@Model.LastModifiedBy</a>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            @if (Model.IsDeleted == false&&Model.IsAnswered==false)
                            {
                                <a onclick="ShowAddingItemForm('@Url.Action("Answer","ContactUs",new{id=Model.Id})','پاسخ به درخواست')" class="btn btn-primary">پاسخ به درخواست</a>
                            }
                            <a asp-area="Admin" asp-controller="ContactUs" asp-action="List" class="btn btn-secondary">برگشت به لیست</a>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>