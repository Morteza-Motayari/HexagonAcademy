@using Hexagon.Domain.ViewModels.Contact_Us
@model AnswerContactUsViewModel
<form asp-area="Admin" asp-controller="ContactUs" asp-action="Answer"
      method="post"
      data-ajax="true"
      data-ajax-method="post"
      data-ajax-success="OnSuccessAddingItem">
    <input type="hidden" asp-for="Id" />
    <div class="row">
        <div class="col-8">
            <div class="form-group">
                <label asp-for="FullName" class="form-label"></label>
                <input asp-for="FullName" class="form-control"  disabled=""/>
            </div>
        </div>
        <div class="col-12">
            <div class="form-group">
                <label asp-for="Answer" class="form-label"></label>
                <textarea class="form-control " asp-for="Answer" cols="30" rows="5" placeholder="پاسخ به درخواست کاربر"></textarea>
            </div>
        </div>
    </div>
    <div class="form-group mt-3">
        <input type="submit" value="ارسال پاسخ" class="btn btn-success " />
    </div>
</form>