@using Hexagon.Application.Convertors
@using Hexagon.Application.Extensions
@using Hexagon.Domain.Enums.Filter
@using Hexagon.Domain.ViewModels.Contact_Us
@model FilterContactUsViewModel
@{
    ViewData["Title"] = "لیست درخواست ها";
}
<div class="row">
    <div class="pl-3">
        <nav style="--bs-breadcrumb-divider: '>';" aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Home" asp-action="Index">خانه</a></li>
                <li class="breadcrumb-item active" aria-current="page"><a asp-area="Admin" asp-controller="ContactUs" asp-action="List">درخواست ها</a></li>
            </ol>
        </nav>
    </div>
    <div class="col-12">
        <div class="card">
            <div class="header">
                <h2><i class="fe fe-24 fe-zoom-in"></i> فیلترها</h2>
                <div class="toolbar">
                    <div class="col-12">
                        <form class="form" method="post" id="filter-search" asp-area="Admin" asp-controller="ContactUs" asp-action="List">
                            <input type="hidden" asp-for="Page" />
                            <div class="form-row row pl-4">
                                <div class="col-12 col-sm-6 col-md-4">
                                    <div class="form-group">
                                        <label asp-for="Subject" class="control-label"></label>
                                        <input asp-for="Subject" class="form-control form-control">
                                    </div>
                                </div>
                                <div class="col-12 col-sm-6 col-md-4">
                                    <div class="form-group">
                                        <label asp-for="FullName" class="control-label"></label>
                                        <input asp-for="FullName" class="form-control form-control">
                                    </div>
                                </div>
                                <div class="col-12 col-sm-6 col-md-4">
                                    <div class="form-group">
                                        <label asp-for="AnsweredUser" class="control-label"></label>
                                        <input asp-for="AnsweredUser" class="form-control form-control">
                                    </div>
                                </div>
                                <div class="col-12 col-sm-6 col-md-4">
                                    <div class="form-group">
                                        <label asp-for="Email" class="control-label"></label>
                                        <input asp-for="Email" class="form-control form-control">
                                    </div>
                                </div>
                                <div class="col-12 col-sm-6 col-md-3">
                                    <div class="form-group">
                                        <label asp-for="AnswerStatus" class="control-label"></label>
                                        <select asp-for="AnswerStatus" class="form-control">
                                            @foreach (var item in Enum.GetValues(typeof(FilterContactUsStatus)).Cast<FilterContactUsStatus>().ToList())
                                            {
                                                @if (Model.AnswerStatus == item)
                                                {
                                                    <option selected value="@item">@item.GetDisplayName()</option>
                                                }
                                                else
                                                {
                                                    <option value="@item">@item.GetDisplayName()</option>
                                                }
                                            }
                                        </select>
                                    </div>
                                </div>
                                <div class="col-12 col-sm-6 col-md-3">
                                    <div class="form-group">
                                        <label asp-for="Status" class="control-label"></label>
                                        <select asp-for="Status" class="form-control">
                                            @foreach (var item in Enum.GetValues(typeof(ExistingStatus)).Cast<ExistingStatus>().ToList())
                                            {
                                                @if (Model.Status == item)
                                                {
                                                    <option selected value="@item">@item.GetDisplayName()</option>
                                                }
                                                else
                                                {
                                                    <option value="@item">@item.GetDisplayName()</option>
                                                }
                                            }
                                        </select>
                                    </div>
                                </div>
                                <div class="col-12 col-sm-6 col-md-2 py-2">
                                    <label class="control-label">
                                        نمایش ورودی
                                        <select asp-for="TakeEntity" aria-controls="DataTables_Table_0" class="custom-select custom-select-sm form-control form-control-sm">
                                            <option value="3">3</option>
                                            <option value="5">5</option>
                                            <option value="10">10</option>
                                            <option value="25">15</option>
                                        </select>
                                    </label>
                                </div>
                                <div class="col-12 col-sm-12 ">
                                    <input type="submit" value="جستجو" class="btn btn-outline-success" />
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
            <div class="body">
                <h2>
                    <i class="fe fe-monitor fe-24"></i> @ViewData["Title"]
                </h2>
                <div class="table-responsive">
                    <div id="tableExport_wrapper" class="dataTables_wrapper dt-bootstrap4">
                        <table class="table table-borderless dataTable table-responsive w-100 d-block d-table table-hover" role="grid">
                            <thead class="thead-dark">
                                <tr role="row">
                                    <th class="center sorting" tabindex="0" aria-controls="tableExport" rowspan="1" colspan="1" aria-label="نام: activate to sort column ascending">نام</th>
                                    <th class="center sorting" tabindex="0" aria-controls="tableExport" rowspan="1" colspan="1" aria-label="موضوع: activate to sort column ascending">موضوع</th>
                                    <th class="center sorting" tabindex="0" aria-controls="tableExport" rowspan="1" colspan="1" aria-label="تلفن: activate to sort column ascending">تلفن</th>
                                    <th class="center sorting" tabindex="0" aria-controls="tableExport" rowspan="1" colspan="1" aria-label="ایمیل: activate to sort column ascending">ایمیل</th>
                                    <th class="center sorting" tabindex="0" aria-controls="tableExport" rowspan="1" colspan="1" aria-label="تاریخ ثبت: activate to sort column ascending">تاریخ ثبت</th>
                                    <th class="center sorting" tabindex="0" aria-controls="tableExport" rowspan="1" colspan="1" aria-label="وضعیت پاسخ: activate to sort column ascending">وضعیت پاسخ</th>
                                    <th class="center sorting" tabindex="0" aria-controls="tableExport" rowspan="1" colspan="1" aria-label="پاسخ دهنده: activate to sort column ascending">پاسخ دهنده</th>
                                    <th class="center sorting" tabindex="0" aria-controls="tableExport" rowspan="1" colspan="1" aria-label="تاریخ پاسخ: activate to sort column ascending">تاریخ پاسخ</th>
                                    <th class="center sorting" tabindex="0" aria-controls="tableExport" rowspan="1" colspan="1" aria-label="اقدام: activate to sort column ascending">اقدام</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Entities.CheckNullability())
                                {
                                    @foreach (var item in Model.Entities)
                                    {
                                        <tr role="row" class="@((item.IsDeleted==true)?"bg-danger":"") text-dark">
                                            <td class="center">@item.FullName</td>
                                            <td class="center">@item.Subject</td>
                                            <td class="center">@item.Phone</td>
                                            <td class="center">@item.Email</td>
                                            <td class="center">@item.CreatedDate.ToShamsi()</td>
                                            <td class="center">
                                                @if (item.IsAnswered == true)
                                                {
                                                    <span class="badge badge-success text-white">پاسخ داده شده</span>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-warning text-white">منتظر پاسخ</span>
                                                }
                                            </td>
                                            <td class="center">@item.UserAnswered</td>
                                            <td class="center">@item.AnsweredDate.ToShamsi()</td>
                                            <td class="center">
                                                <a asp-area="Admin" asp-controller="ContactUs" asp-action="Detail" asp-route-id="@item.Id" class="text-secondary">
                                                    <i class="fe fe-24 fe-alert-circle"></i>
                                                </a>
                                                @if (item.IsDeleted == false)
                                                {
                                                    <a onclick="ShowAddingItemForm('@Url.Action("Answer","ContactUs",new{id=item.Id})','پاسخ به درخواست')" class="text-success">
                                                        <i class="fe fe-24 fe-edit-3"></i>
                                                    </a>
                                                    <a onclick="confirmDelete('@Url.Action("Delete","ContactUs",new{id=item.Id})',event,'درخواست @item.FullName')" class="text-danger">
                                                        <i class="fe fe-24 fe-trash-2"></i>
                                                    </a>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="footer">
                <div class="dataTables_info" id="tableExport_info" role="status" aria-live="polite">نمایش @Model.StartItemFromList تا @Model.EndItemFromList از @Model.AllEntitiesCount ورودی</div>
                @if (Model.PageCount > 1)
                {
                    <partial name="_AdminPaging" model="Model.GetCurrentPaging()" />
                }
            </div>

        </div>
    </div>
</div>