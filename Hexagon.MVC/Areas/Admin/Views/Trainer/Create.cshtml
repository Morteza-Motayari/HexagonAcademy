@using Hexagon.Application.Extensions
@using Hexagon.Domain.ViewModels.Records.Certificates
@using Hexagon.Domain.ViewModels.Users.Staffs.Trainers
@model CreateTrainerViewModel
@{
    ViewData["Title"] = "افزودن مربی جدید";
    List<CertificateViewModel> certificates = ViewData["Certificates"] as List<CertificateViewModel> ?? new List<CertificateViewModel>();
}
<div class="row">
    <div class="pl-3">
        <nav style="--bs-breadcrumb-divider: '>';" aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Home" asp-action="Index">خانه</a></li>
                <li class="breadcrumb-item active" aria-current="page"><a asp-area="Admin" asp-controller="Trainer" asp-action="List">مربیان</a></li>
                <li class="breadcrumb-item active" aria-current="page"><a asp-area="Admin" asp-controller="Trainer" asp-action="Create">افزودن مربی</a></li>
            </ol>
        </nav>
    </div>
    <div class="col-12">
        <div class="card">
            <div class="header">
                <h2 class="mt-3">
                    <i class="bx bx-cycling bxl"></i> @ViewData["Title"]
                </h2>
            </div>
            <div class="body">
                <form method="post" enctype="multipart/form-data" asp-area="Admin" class="row col-md-12" asp-controller="Trainer" asp-action="Create">
                    <div class="col-md-8">
                        <div class="row">
                            <div class="form-group col-md-12">
                                <label asp-for="UserId" class="form-control-label"></label>
                                <select asp-for="UserId" class="form-control" id="ajaxMultiSelect2HTML">
                                </select>
                                <p></p>
                                <span asp-validation-for="UserId" class="text-danger"></span>
                            </div>
                            <br />
                            <div class="form-group col-md-6">
                                <label asp-for="Position" class="form-control-label"></label>
                                <input asp-for="Position" class="form-control" />
                                <span asp-validation-for="Position" class="text-danger"></span>
                            </div><div class="form-group col-md-6">
                                <label asp-for="Salary" class="form-control-label"></label>
                                <input asp-for="Salary" class="form-control" id="salaryInput" />
                                <span asp-validation-for="Salary" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <h2>مدرک ها</h2>
                        <hr />
                        <div>
                            @if (certificates.CheckNullability())
                            {
                                @foreach (var item in certificates)
                                {
                                    <div class="custom-checkbox">
                                        <input type="checkbox" class="bxs" name="TrainerCertificatesIds" value="@item.Id">
                                        <label for="customCheck1">@item.Name</label>
                                    </div>
                                }
                                <span asp-validation-for="TrainerCertificatesIds" class="text-danger"></span>
                            }
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <input type="submit" value="ایجاد مربی" class="btn btn-success" />
                            <a asp-area="Admin" asp-controller="Trainer" asp-action="List" class="btn btn-secondary">برگشت به لیست</a>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        $("#ajaxMultiSelect2HTML").select2({
            width: '100%',
            dir: "rtl",
            placeholder: " اسم کاربر را وارد بکنید ",
            theme: "bootstrap4",
            allowClear: true,
            ajax: {
                url: "/Admin/User/Search",
                contentType: "application/json; charset=utf-8",
                data: function (params) {
                    console.log("Search term:", params.term);
                    return { term: params.term || "" }; // Ensure params.term is defined
                },
                processResults: function (result) {
                    console.log(result);
                    return {
                        results: $.map(result, function (item) {
                            const firstName = item.firstName || "نام";
                            const lastName = item.lastName || "نام خانوادگی";
                            const phoneNumber = item.phoneNumber || "09xxxxxxxxx";
                            const avatar = item.avatar || "default.png";
                            return {
                                id: item.id,
                                text: `${firstName} ${lastName}`,
                                html: `
                                    <div style="display:flex;">
                                        <div>
                                            <img src="/Images/Avatars/${avatar}" alt=""
                                                 style="height:70px;width:70px;object-fit:cover;"
                                                 class="img-rounded img-responsive" />
                                        </div>
                                        <div style="padding:10px">
                                            <div style="font-size: 1.2em;">${firstName} ${lastName}</div>
                                            <div>شماره :تلفن <b>${phoneNumber}</b></div>
                                        </div>
                                    </div>`,
                            };
                        }),
                    };                    
                },
                cache: true,                          
            },
            templateResult: function (data) {
                return data.html ? $(data.html) : data.text;
            },
            language: {
                noResults: function (params) {
                    // Safely access params.term
                    const searchTerm = params?.term || ""; // Default to empty string if params is undefined
                    return searchTerm
                        ? `هیچ کاربری با عبارت "${searchTerm}". یافت نشد لطفا دوباره جستجو بکنید.`
                        : "کاربری یافت نشد.";
                },
                searching: function () {
                    return "در حال جستجو";
                },
            },
            escapeMarkup: function (markup) {
                return markup; // Allows dynamic message with HTML
            },
        });
    </script>
    <script>
        document.getElementById('salaryInput').addEventListener('input', function (e) {
            // Remove all non-digit characters (except period if you want to allow decimals)
            let value = e.target.value.replace(/[^0-9]/g, '');

            // Format the number with commas
            e.target.value = value.replace(/\B(?=(\d{3})+(?!\d))/g, ',');
        });

        // Optional: Strip commas before submitting the form
        document.getElementById('salaryInput').addEventListener('blur', function (e) {
            e.target.value = e.target.value.replace(/,/g, '');
        });
    </script>
}