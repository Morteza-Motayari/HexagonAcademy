@using Hexagon.Domain.ViewModels.Gyms.Sports
@using Hexagon.Domain.ViewModels.Records.Certificates
@model UpdateSportViewModel
@{
    ViewData["Title"] = "ویرایش رشته ورزشی";
    List<CertificateViewModel> CertificateItems = ViewData["Certificates"] as List<CertificateViewModel> ?? new List<CertificateViewModel>();
    var Options = new SelectList(CertificateItems, "Id", "Name");
}
<form asp-action="Edit" method="post"
      data-ajax="true"
      data-ajax-method="post"
      data-ajax-success="OnSuccessAddingItem">
      <input asp-for="Id" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="col-md-12">
        <div class="row">
            <div class="form-group col-md-6">
                <label asp-for="Title" class="form-control-label"></label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>
            <div class="form-group col-md-6">
                <label asp-for="CertificateId" class="form-control-label"></label>
                <select asp-for="CertificateId" class="form-control" asp-items="Options">
                    <option value="">مدرک مورد نظر را انتخاب کنید ...</option>
                </select>
                <span asp-validation-for="CertificateId" class="text-danger"></span>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="form-group">
            <input type="submit" value="ویرایش رشته ورزشی" class="btn btn-primary" />
            <a asp-area="Admin" asp-controller="Sport" asp-action="List" class="btn btn-secondary">برگشت به لیست</a>
        </div>
    </div>
</form>