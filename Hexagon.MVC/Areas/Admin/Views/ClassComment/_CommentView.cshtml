@using Hexagon.Application.Convertors
@using Hexagon.Domain.Enums.SportClasses
@using Hexagon.Domain.ViewModels.Gyms.ClassComments
@model CommentViewModel
<form asp-area="" asp-controller="ClassComment"
    asp-action="GetComment" method="post"
      data-ajax="true"
      data-ajax-method="post"
      data-ajax-success="OnSuccessAddingItem">
    <input asp-for="Id" type="hidden" />
    <div class="col-md-12">
        <div class="row">
            <div class="form-group col-md-4">
                <label asp-for="UserName" class="form-control-label"></label>
                <p><strong>@Model.UserName</strong></p>
            </div>
            <div class="form-group col-md-4">
                <label asp-for="SportClass" class="form-control-label"></label>
                <p><strong>@Model.SportClass</strong></p>
            </div>
            <div class="form-group col-md-4">
                <label asp-for="CreatedDate" class="form-control-label"></label>
                <p class="m-t-15 m-b-15 text-muted"><strong>@Model.CreatedDate.ToShamsi()</strong></p>
            </div>
            <div class="form-group col-md-12">
                <label asp-for="Comment" class="form-control-label"></label>
                <p ><strong>@Model.Comment</strong></p>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="form-group">
            @if (Model.IsDeleted == false)
            {
                @if (Model.CommentStatus != ClassCommentPending.Accepted)
                {
                    <button onclick="changeCommentStatus('@Url.Action("AcceptComment","ClassComment",new{id=Model.Id})')"  class="btn btn-outline-success">تایید کردن</button>
                }
                @if (Model.CommentStatus != ClassCommentPending.Rejected)
                {
                    <button onclick="changeCommentStatus('@Url.Action("RejectComment","ClassComment",new{id=Model.Id})')" class="btn btn-outline-danger">رد کردن</button>
                }
            }
        </div>
    </div>
</form>