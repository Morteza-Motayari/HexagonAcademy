@using Hexagon.Application.Convertors
@using Hexagon.Application.Extensions
@using Hexagon.Application.Statics
@using Hexagon.Domain.ViewModels.Users.Staffs.Caders
@model AdminSideDetailCaderViewModel
@{
    ViewData["Title"] = "جزئیات کادر";
}
<div class="row">
    <div class="pl-3">
        <nav style="--bs-breadcrumb-divider: '>';" aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Home" asp-action="Index">خانه</a></li>
                <li class="breadcrumb-item active" aria-current="page"><a asp-area="Admin" asp-controller="Cader" asp-action="List">کادر ها</a></li>
                <li class="breadcrumb-item active" aria-current="page"><a asp-area="Admin" asp-controller="Cader" asp-action="Detail" asp-route-id="@Model.Id">جزئیات کادر</a></li>
            </ol>
        </nav>
    </div>
    <div class="col-12">
        <div class="card">
            <div class="header">
                <h2 class="mt-3">
                    <i class="fe fe-24 fe-user-check"></i> @ViewData["Title"]
                </h2>
            </div>
            <div class="body">
                <div class="row col-md-12">
                    <div class="col-md-8">
                        <div class="row">
                            <div class="form-group col-md-6">
                                <label asp-for="FullName" class="form-control-label"></label>
                                <a asp-area="Admin" asp-controller="User" asp-action="Detail" class="form-control color-disabled" asp-route-id="@Model.UserId">@Model.FullName</a>
                            </div>
                            <div class="form-group col-md-6">
                                <label asp-for="PhoneNumber" class="form-control-label"></label>
                                <input asp-for="PhoneNumber" class="form-control" disabled="" />
                            </div><div class="form-group col-md-6">
                                <label asp-for="PhoneNumber" class="form-control-label"></label>
                                <input asp-for="PhoneNumber" class="form-control" disabled="" />
                            </div><div class="form-group col-md-6">
                                <label asp-for="Salary" class="form-control-label"></label>
                                <input value="@Model.Salary.ToMoney()" class="form-control" disabled="" />
                            </div><div class="form-group col-md-6">
                                <label asp-for="NationalCode" class="form-control-label"></label>
                                <input asp-for="NationalCode" class="form-control" disabled="" />
                            </div>
                            <div class="form-group col-md-6">
                                <label asp-for="city" class="form-control-label"></label>
                                <input asp-for="city" class="form-control" disabled="" />
                            </div>
                            <div class="form-group col-md-12">
                                <label asp-for="email" class="form-control-label"></label>
                                <input asp-for="email" class="form-control" disabled="" />
                            </div>
                            <div class="form-group col-md-4">
                                <label asp-for="Gender"></label>
                                <div class="custom-radio">
                                    <input asp-for="Gender" value="@Model.Gender?.GetDisplayName()" disabled="" class="form-control bxs">
                                </div>
                            </div>
                            <div class="form-group col-md-4">
                                <label asp-for="Position" class="control-label"></label>
                                <input asp-for="Position" disabled="" class="form-control bxs">
                            </div>
                            <div class="form-group col-md-4">
                                <label asp-for="BirthDay" class="control-label"></label>
                                <input asp-for="BirthDay" type="text" class="form-control" id="birthDay" disabled="">
                            </div>
                            <div class="form-group col-md-6">
                                <label asp-for="CreatedDate" class="control-label"></label>
                                <input value="@Model.CreatedDate.ToShamsiWithHour()" type="text" class="form-control" id="birthDay" disabled="">
                            </div>
                            <div class="form-group col-md-6">
                                <label asp-for="LastModifiedDate" class="control-label"></label>
                                <input value="@Model.LastModifiedDate?.ToShamsiWithHour()" type="text" class="form-control" id="birthDay" disabled="">
                            </div>
                            <div class="form-group col-md-6">
                                <label asp-for="CreatedBy" class="form-control-label"></label>
                                <a asp-area="Admin" asp-controller="User" asp-action="Detail" asp-route-id="@Model.CreatedById">@Model.CreatedBy</a>
                            </div>
                            <div class="form-group col-md-6">
                                <label asp-for="LastModifiedBy" class="form-control-label"></label>
                                <a asp-area="Admin" asp-controller="User" asp-action="Detail" asp-route-id="@Model.LastModifiedById">@Model.LastModifiedBy</a>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="row ">
                            <div class="col-md-3 text-center">
                                <label asp-for="Avatar" class="control-label"></label>
                                <div class="avatar avatar-xl contact-photo">
                                    <img id="avatar" src="@SavingPath.AvatarPath@((!string.IsNullOrEmpty(Model.Avatar))?$"{Model.Avatar}":"default.png")" alt="..." class="img-responsive">
                                </div>
                            </div>
                        </div>
                        @if (Model.IsDeleted == true)
                        {
                            <div class="row ">
                                <div class=" text-center">
                                    <p class="h2 mb-3 text-danger">این کادر حذف شده است</p>
                                </div>
                            </div>
                        }
                        <br />
                        @if (Model.CaderRoles.CheckNullability())
                        {
                            <div>
                                <h2>نقش ها</h2>
                                <hr />
                                @foreach (var item in Model.CaderRoles)
                                {
                                    <a asp-area="Admin" asp-controller="Role" asp-action="Detail" class="btn mb-2 @((item.IsDeleted==true)?"btn-outline-danger":"btn-outline-primary")" asp-route-id="@item.Id">
                                        @item.RoleTitle
                                        <span class="fe fe-arrow-left fe-16 bxs"></span>
                                    </a>
                                }
                            </div>
                        }
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            @if (Model.IsDeleted == false)
                            {
                                <a asp-area="Admin" asp-controller="Cader" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">ویرایش مربی</a>
                            }
                            <a asp-area="Admin" asp-controller="Cader" asp-action="List" class="btn btn-secondary">برگشت به لیست</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>