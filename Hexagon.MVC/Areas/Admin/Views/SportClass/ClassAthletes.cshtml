@using Hexagon.Application.Convertors
@using Hexagon.Application.Extensions
@using Hexagon.Domain.Enums.Filter
@using Hexagon.Domain.ViewModels.Gyms.SportClasses
@model FilterSportClassAthleteViewModel
@{
    ViewData["Title"] = $"لیست ورزشکارهای {Model.SportClassTitle}";
}
<div class="row">
    <div class="pl-3">
        <nav style="--bs-breadcrumb-divider: '>';" aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Home" asp-action="Index">خانه</a></li>
                <li class="breadcrumb-item active" aria-current="page"><a asp-area="Admin" asp-controller="SportClass" asp-action="List">کلاس های ورزشی</a></li>
                <li class="breadcrumb-item active" aria-current="page"><a asp-area="Admin" asp-controller="SportClass" asp-action="ClassAthletes" asp-route-SportClassId="@Model.SportClassId">ورزشکارهای @Model.SportClassTitle</a></li>
            </ol>
        </nav>
    </div>
    <div class="col-12">
        <div class="card">
            <div class="header">
                <h2><i class="fe fe-24 fe-zoom-in"></i> فیلترها</h2>
                <div class="toolbar">
                    <div class="col-12">
                        <form class="form" method="post" id="filter-search" asp-area="Admin" asp-controller="SportClass" asp-action="ClassAthletes">
                            <input type="hidden" asp-for="Page" />
                            <input type="hidden" asp-for="SportClassId" />
                            <input type="hidden" asp-for="SportClassTitle" />
                            <div class="form-row row pl-4">
                                <div class="col-12 col-sm-6 col-md-4">
                                    <div class="form-group">
                                        <label asp-for="AthleteName" class="control-label"></label>
                                        <input asp-for="AthleteName" class="form-control form-control">
                                    </div>
                                </div>
                                <div class="col-12 col-sm-6 col-md-2">
                                    <div class="form-group">
                                        <label asp-for="ExtensionStatus" class="control-label"></label>
                                        <select asp-for="ExtensionStatus" class="form-control">
                                            @foreach (var item in Enum.GetValues(typeof(FilterRegisteredAthletesStatus)).Cast<FilterRegisteredAthletesStatus>().ToList())
                                            {
                                                @if (Model.ExtensionStatus == item)
                                                {
                                                    <option selected value="@item">@item.GetDisplayName()</option>
                                                }
                                                else
                                                {
                                                    <option value="@item">@item.GetDisplayName()</option>
                                                }
                                            }
                                        </select>
                                    </div>
                                </div>
                                <div class="col-12 col-sm-6 col-md-2 py-2">
                                    <label class="control-label">
                                        نمایش ورودی
                                        <select asp-for="TakeEntity" aria-controls="DataTables_Table_0" class="custom-select custom-select-sm form-control form-control-sm">
                                            <option value="3">3</option>
                                            <option value="5">5</option>
                                            <option value="10">10</option>
                                            <option value="25">15</option>
                                        </select>
                                    </label>
                                </div>
                                <div class="col-12 col-sm-12 ">
                                    <input type="submit" value="جستجو" class="btn btn-outline-success" />
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
            <div class="body">
                <h2><i class="fe fe-users text-dark bxl"></i> @ViewData["Title"]</h2>
                <div class="table-responsive">
                    <div id="tableExport_wrapper" class="dataTables_wrapper dt-bootstrap4">
                        <table class="table table-borderless dataTable table-responsive w-100 d-block d-table table-hover" role="grid">
                            <thead class="thead-dark">
                                <tr role="row">
                                    <th class="center sorting" tabindex="0" aria-controls="tableExport" rowspan="1" colspan="1" aria-label="نام: activate to sort column ascending">نام </th>
                                    <th class="center sorting" tabindex="0" aria-controls="tableExport" rowspan="1" colspan="1" aria-label="نام: activate to sort column ascending">وضعیت ثبت نام</th>
                                    <th class="center sorting" tabindex="0" aria-controls="tableExport" rowspan="1" colspan="1" aria-label="تاریخ ثبت نام: activate to sort column ascending">تاریخ ثبت نام</th>
                                    <th class="center sorting" tabindex="0" aria-controls="tableExport" rowspan="1" colspan="1" aria-label="تاریخ آخرین تمدید: activate to sort column ascending">تاریخ آخرین تمدید</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Entities.CheckNullability())
                                {
                                    @foreach (var item in Model.Entities)
                                    {
                                        <tr role="row" class="text-dark">
                                            <td class="center"><a asp-area="Admin" asp-controller="User" asp-action="Detail" asp-route-id="@item.UserId">@item.UserName</a></td>
                                            <td class="center">
                                                @if (item.ExtensionDate.OneMonthPassed())
                                                {
                                                    <span class="badge badge-warning text-white">@FilterRegisteredAthletesStatus.NeedExtension.GetDisplayName()</span>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-success text-white">@FilterRegisteredAthletesStatus.Registered.GetDisplayName()</span>
                                                }
                                            </td>
                                            <td class="center">@item.RegisteredDate.ToShamsiWithPersianMonth()</td>
                                            <td class="center">@item.ExtensionDate.ToShamsiWithPersianMonth()</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="footer">
                <div class="dataTables_info" id="tableExport_info" role="status" aria-live="polite">نمایش @Model.StartItemFromList تا @Model.EndItemFromList از @Model.AllEntitiesCount ورزشکار</div>
                @if (Model.PageCount > 1)
                {
                    <partial name="_AdminPaging" model="Model.GetCurrentPaging()" />
                }
            </div>

        </div>
    </div>
</div>