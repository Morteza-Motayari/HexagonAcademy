@using Hexagon.Domain.Enums.Filter
@using Hexagon.Domain.ViewModels.Users.Roles
@using Hexagon.Application.Extensions
@using Hexagon.Application.Convertors
@model FilterRoleViewModel

@{
    ViewData["Title"] = "لیست نقش ها";
    int j = 0;
}
<div class="row">
    <div class="pl-3">
        <nav style="--bs-breadcrumb-divider: '>';" aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Home" asp-action="Index">خانه</a></li>
                <li class="breadcrumb-item active" aria-current="page"><a asp-area="Admin" asp-controller="Role" asp-action="List"> نقش ها</a></li>
            </ol>
        </nav>

    </div>
    <div class="col-12">
        <div class="card">
            <div class="header">
                <h2>فیلترها</h2>
                <div class="toolbar">
                    <div class="col-12">
                        <form class="form" method="post" id="filter-search" asp-area="Admin" asp-controller="Role" asp-action="List">
                            <input type="hidden" asp-for="Page" />
                            <div class="form-row row pl-4">
                                <div class="col-12 col-sm-6 col-md-4">
                                    <div class="form-group">
                                        <label asp-for="Title" class="control-label"></label>
                                        <input asp-for="Title" class="form-control form-control">
                                    </div>
                                </div>
                                <div class="col-12 col-sm-6 col-md-4">
                                    <div class="form-group">
                                        <label asp-for="Status" class="control-label"></label>
                                        <select asp-for="Status" class="form-control">
                                            @foreach (var item in Enum.GetValues(typeof(ExistingStatus)).Cast<ExistingStatus>().ToList())
                                            {
                                                @if (Model.Status == item)
                                                {
                                                    <option selected value="@item">@item.GetDisplayName()</option>
                                                }
                                                else
                                                {
                                                    <option value="@item">@item.GetDisplayName()</option>
                                                }
                                            }
                                        </select>
                                    </div>
                                </div>
                                <div class="col-12 col-sm-6 col-md-4 py-2">
                                    <label class="control-label">
                                        نمایش ورودی
                                        <select asp-for="TakeEntity" aria-controls="DataTables_Table_0" class="custom-select custom-select-sm form-control form-control-sm">
                                            <option value="5">5</option>
                                            <option value="10">10</option>
                                            <option value="25">25</option>
                                            <option value="50">50</option>
                                            <option value="100">100</option>
                                        </select>
                                    </label>
                                </div>
                                <div class="col-12 col-sm-12 ">
                                    <input type="submit" value="جستجو" class="btn btn-outline-success" />
                                </div>
                            </div>
                        </form>
                    </div>
                    <br />
                    <p class="col-12">
                        <a onclick="ShowAddingItemForm('@Url.Action("Create","Role")',' افزودن نقش جدید')" class="btn btn-success text-white">ایجاد نقش جدید</a>
                    </p>

                </div>
            </div>
            <div class="body">
                <h2>@ViewData["Title"]</h2>
                <div class="table-responsive">
                    <div id="tableExport_wrapper" class="dataTables_wrapper dt-bootstrap4">
                        <table class="table table-borderless dataTable table-responsive w-100 d-block d-md-table table-hover" role="grid">
                            <thead class="thead-dark">
                                <tr role="row">
                                    <th class="center sorting" tabindex="0" aria-controls="tableExport" rowspan="1" colspan="1" aria-label="عنوان نقش: activate to sort column ascending" style="width: 149.188px;">عنوان نقش</th>
                                    <th class="center sorting" tabindex="0" aria-controls="tableExport" rowspan="1" colspan="1" aria-label="وضعیت: activate to sort column ascending" style="width: 89.9125px;">وضعیت</th>
                                    <th class="center sorting" tabindex="0" aria-controls="tableExport" rowspan="1" colspan="1" aria-label="تاریخ: activate to sort column ascending" style="width: 86.1375px;">تاریخ</th>
                                    <th class="center sorting" tabindex="0" aria-controls="tableExport" rowspan="1" colspan="1" aria-label="اقدام: activate to sort column ascending" style="width: 70.8875px;">اقدام</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Entities.CheckNullability())
                                {
                                    @foreach (var item in Model.Entities)
                                    {
                                        {
                                            j++;
                                        }
                                        <tr role="row" class="@((j%2==0)?"even":"odd")@((item.IsDeleted==true)?" bg-warning":"") text-dark">
                                            <td class="center">@item.RoleTitle</td>
                                            <td class="center">
                                                @if (item.IsDeleted == true)
                                                {
                                                    <span class="badge badge-danger text-white">حذف شده</span>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-success text-white">موجود می باشد</span>
                                                }
                                            </td>
                                            <td class="center">@item.CreatedDate.ToShamsi()</td>
                                            <td class="center">
                                                @if (item.IsDeleted == false)
                                                {
                                                    <a onclick="ShowAddingItemForm('@Url.Action("Edit","Role",new{roleId=item.Id})',' ویرایش نقش ')" class="text-success">
                                                        <i class="fe fe-24 fe-edit-3"></i>
                                                    </a>
                                                    <a onclick="confirmDelete('@Url.Action("Delete","Role",new{id=item.Id})',event,'@item.RoleTitle')" class="text-danger">
                                                        <i class="fe fe-24 fe-trash-2"></i>
                                                    </a>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            @if (Model.PageCount > 1)
            {
                <div class="footer">
                    <div class="dataTables_info" id="tableExport_info" role="status" aria-live="polite">نمایش 1 تا 10 از 16 ورودی</div>
                    <partial name="_AdminPaging" model="Model.GetCurrentPaging()" />
                </div>
            }
        </div>
    </div>
</div>

