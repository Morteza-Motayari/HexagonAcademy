@using Hexagon.Domain.ViewModels.Users.Roles;
@model UpdateRoleViewModel
@{
    ViewData["Title"] = "ویرایش نقش";
}
<div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
    <div class="card">
        <div class="header">
            <h2>
                <strong>@ViewData["Title"]</strong>
            </h2>
        </div>
        <div class="body">
            <form asp-action="Create" method="post">
                <input type="hidden" asp-for="Id" />
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <label for="email_address">آدرس ایمیل</label>
                <div class="form-group">
                    <label asp-for="RoleTitle" class="control-label"></label>
                    <input asp-for="RoleTitle" class="form-control" />
                    <span asp-validation-for="RoleTitle"></span>
                </div>
                <div class="form-group">
                    <label asp-for="RoleName" class="control-label"></label>
                    <input asp-for="RoleName" class="form-control" />
                    <span asp-validation-for="RoleName"></span>
                </div>
                <br>
                <div class="form-group">
                    <input type="submit" value="ویرایش" class="btn btn-primary m-t-15 waves-effect" />
                    <a asp-area="Admin" asp-controller="Role" asp-action="List" class="btn btn-secondary m-t-15 waves-effect ">برگشت به لیست</a>
                </div>
            </form>
        </div>
    </div>
</div>